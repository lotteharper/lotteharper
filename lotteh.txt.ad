					face = true;
					break;
				}
			}
		}
	}
	if(!face) {
		for(rot in rotation_attempts) {
			drawRotated(rot, video, true);
			var faces = ccv.detect_objects({
			  "canvas" : ccv.pre(canvas),
			  "cascade": cascade,
			  "interval": 2,
