  width: 70px;
  height: 70px;
  animation: spin 4s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
</style>
{% endblock %}
{% block content %}
<div class="container w-100">
{% if request.path == '/photobooth/'  %}
{% include 'set_content.html' %}
{% endif  %}
