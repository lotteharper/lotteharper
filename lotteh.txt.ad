{% load static %}{% load app_filters %}{% load feed_filters %}{% load filters %}{% linebreakless %}{% load webpush_notifications %}
<!DOCTYPE html>
<html lang="{{ lang }}">
    <head>
        {% if not hidega %}
        {% if show_ads %}
        {% include 'google_adsense_head_code.html' %}
        {% endif %}
        {% include 'gtmhead.html' %}
        {% endif %}
        {% if not request.path == '/verify/age/' %}
        {% webpush_header %}
        {% endif %}
