.dynamicClockContainer { 
    position: relative; 
    display: inline-block;
    margin: auto; 
    height: 40px;
    width: 40px;
    border-radius: 50%;
    background-size: 100%; 
    border: 2px solid white;
} 
.xlDynamicClockContainer { 
    position: relative; 
    display: inline-block;
    margin: auto; 
    height: 80px;
    width: 80px;
    border-radius: 50%;
    background-size: 100%; 
    border: 2px solid white;
} 
.hour, 
.minute, 
