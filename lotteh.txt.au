```html
{% load app_filters %}
{% load feed_filters %}
{% load cookielaw_tags %}
{% if cookielaw.notset %}{% rejectable_cookielaw_banner %}{% endif %}
<nav class="navbar fixed-top navbar-expand-lg {% if not darkmode %}navbar-light bg-light border-bottom border-dark{% else %}navbar-dark bg-dark{% endif %} p-2 d-flex" id="clemn-navbar">
  <div class="container-fluid clemn-navbar">
    {% if request.user.is_authenticated and not request.user.profile.hide_logo or not request.user.is_authenticated and not hide_logo %}
    <a style="position: relative; z-index: 1;" class="navbar-brand" href="{% url 'app:app' %}?k={% get_key %}" title="{{ 'The Homepage'|etrans }}" rel="nofollow">
	<img src="{{ icon_url }}" alt="{{ the_site_name }}" width="30" height="30" style="border-radius: 50%;">
	<i style="color: {% if darkmode %}white{% else %}black{% endif %} !important;">{{ the_site_name }}</i>
	<small class="nav-title" style="color: red !important; position: absolute; top: 20px; left: 45px; z-index: 2; font-size: 10px;">{{ the_site_name|etranslang:"ja" }}</small>
    </a>
    {% endif %}
    <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" data-bs-auto-close="true" data-bs-toggle="dropdown" aria-controls="navbarScroll" aria-expanded="false" aria-label="{{ 'Toggle navigation'|etrans }}">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
        {% blocktrans en %}
        <ul class="navbar-nav my-2 my-lg-0 navbar-nav-scroll" style="--bs-scroll-height: 100%;">
            <ul class="navbar-nav mr-auto" style="height: 100%;">
            {% if not request.user.is_authenticated %}
              <li class="nav-item {% if request.path|startswith:'/feed/profile/' %}active{% endif %}">
                <a class="nav-link" href="{% url 'feed:follow' profileusername %}" title="{{ 'Subscribe' }}">{{ 'Subscribe' }}</a>
              </li>
              <li class="nav-item {% if request.path|startswith:'/payments/photo/' %}active{% endif %}">
                <a class="nav-link" href="{% url 'payments:buy-photo-card' profileusername %}" title="{{ 'Buy photos' }}">{{ 'Buy Photos' }}</a>
              </li>
            {% endif %}
              <li class="nav-item {% if request.path == '/payments/webdev/' %}active{% endif %}">
                <a class="nav-link" href="{% url 'payments:webdev' %}" title="{{ 'Learn about our services' }}">{{ 'Services' }}</a>
              </li>
              <li class="nav-item {% if request.path == '/models/' %}active{% endif %}">
                 <a class="nav-link" href="{% url 'feed:profiles' %}" title="{{ 'See profiles from active models' }}">{{ 'Models' }}</a>
              </li>
               {% if my_profile.user.vendor_profile.activate_surrogacy %}
              <li class="nav-item active">
               <a class="nav-link" href="{% url 'payments:surrogacy' profileusername %}" title="{{ 'Surrogacy plans' }}">{{ 'Surrogacy' }}</a>
              </li>
              {% endif %}
              {% if request.user.profile.subscriptions.count > 0 %}
              <li class="nav-item {% if request.path == '/feed/subscriptions/' %}active{% endif %}">
                  <a class="nav-link" href="{% url 'feed:subscriptions' %}" title="{{ 'Your Subscriptions' }}">{{ 'Subscriptions' }}</a>
              </li>
              {% endif %}
              <li class="nav-item{% if request.path|startswith:'/payments/crypto/' %} active{% endif %}">
                <a class="nav-link" href="{% url 'payments:tip-crypto-simple' profileusername %}" title="{{ 'Tip me in Cryptocurrency' }}">{{ 'Tip Crypto' }}</a>
              </li>
            </ul>
        </ul>
        <ul class="navbar-nav align">
    	  {% if user.is_authenticated %}
          <li class="nav-item {% if request.path == '/accounts/profile/' %}active{% endif %}">
            <a class="nav-link" href="{% url 'users:profile' %}" title="{{ 'Your Profile' }}">{{ 'Profile' }}</a>
          </li>
          {% endif %}
          {% if user.is_authenticated and user.profile.vendor %}
          <li class="nav-item {% if request.path == '/feed/post/new/' %}active{% endif %}">
            <a class="nav-link" href="{% url 'feed:new_post' %}" title="{{ 'New Post' }}">{{ 'New' }}</a>
          </li>
          <li class="nav-item {% if request.path == '/go/' %}active{% endif %}">
            <a class="nav-link" href="{% url 'go:go' %}" title="{{ 'Go somewhere useful' }}">{{ 'Go' }}</a>
          </li>
          {% endif %}
        </ul>
        {% endblocktrans %}
        <form class="d-flex" action="{% url 'misc:search' %}" style="margin-left: auto;">
          <input class="form-control mr-sm-2" type="text" placeholder="{{ 'Search'|etrans }}" aria-label="{{ 'Search'|etrans }}" required id="q" name="q"{% if query %} value="{{ query }}"{% endif %} {% if request.path == '/search/' %}autofocus{% endif %}>
          <input class="form-control hide" type="text" id="lang" name="lang" value="{{ lang }}">
          <button class="btn btn-outline-success my-2 my-sm-0" type="submit">{{ 'Search'|etrans }}</button>
        </form>
        <ul class="navbar-nav" style="margin-left: auto;">
          {% blocktrans en %}
          {% if user.is_superuser or user.profile.vendor %}
          <li class="nav-item">
            <a class="nav-link" href="{% url 'barcode:scan' %}?foreign=true&back=true" title="{{ 'Verify an ID with a barcode' }}">{{ 'Scan ID' }}</a>
          </li>
          <li class="nav-item align-middle">
            <a class="nav-link align-middle" href="/admin/" title="{{ 'Admin panel' }}">{{ 'Admin' }}</a>
          </li>
    	  {% elif request.user.profile.idscan_active %}
          <li class="nav-item">
            <a class="nav-link" href="{% url 'barcode:scan' %}?foreign=true&back=true" title="{{ 'Verify an ID with a barcode' }}">{{ 'Scan ID' }}</a>
          </li>
    	  {% else %}
          <li class="nav-item">
            <a class="nav-link" href="{% url 'payments:idscan' %}" title="{{ 'Sign up to scan IDs with a barcode' }}">{{ 'Scan ID' }}</a>
          </li>
          {% endif %}
          {% if not request.user.profile.vendor %}
          <li class="nav-item {% if request.path == '/cart/' %}active{% endif %}">
            <a class="nav-link" href="{% url 'payments:cart-card' %}" title="{{ 'Your shopping cart' }}"><i class="bi bi-cart"></i> {{ 'Cart' }} <i id="cart-counter"></i></a>
          </li>
          {% endif %}
          {% if not request.user.is_authenticated %}
          <li class="nav-item {% if request.path == '/accounts/register/' %}active{% endif %}">
            <a class="nav-link" href="{% url 'users:register' %}" title="{{ 'Join today' }}">{{ 'Sign Up' }}</a>
          </li>
          {% endif %}
          {% if user.is_authenticated %}
          <li class="nav-item {% if request.path == '/accounts/logout/' %}active {% endif %}align-middle">
            <a class="nav-link" href="{% url 'users:logout' %}" title="{{ 'Log out' }}">{{ 'Logout' }}</a>
          </li>
          {% else %}
          <li class="nav-item {% if request.path == '/accounts/login/' %}active {% endif %}align-middle">
            <a class="nav-link" href="{% url 'users:login' %}" title="{{ 'Log in to' }} {{ the_site_name }}">{{ 'Login' }}</a>
          </li>
          {% endif %}
          {% endblocktrans %}
          <li class="nav-item align-middle">
          {% include 'dynamic_time.html' %}
          </li>
          <li class="nav-item align-middle">
          {% include 'dynamic_text_time.html' %}
          </li>
          <li class="nav-item">
	        <a href="{% url 'landing:index' %}" title="{{ 'Visit the landing page'|etrans }}">
                {% include 'sclock.html' %}
            </a>
          </li>
          {% if user_country != None %}
          <li class="nav-item">
            <i style="font-family: 'EmojiFlag'; font-size: 25px;" title="{{ user_country|etrans }} ({{ user_country }}) {{ 'network connection origin'|etrans }}">{{ user_country|getflag }}</i>
          </li>
          {% endif %}
        </ul>
    </div>
  </div>
</nav>
```


