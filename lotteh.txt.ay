                    context['description'] = 'See this photo | ' + (post.content[:120].replace('\n', ' ').replace('\r', '') + '...') if len(post.content.replace('\n', ' ').replace('\r', '')) > 120 else post.content.replace('\n', ' ').replace('\r', '')
