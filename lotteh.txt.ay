});

/**
 * Shows both local and remote video, and hides the "call" button.
 */
function showVideoCall() {
   calling = true;
   hideElement(callButton);
   showElement(videoContainer);
   showElement(endButton);
   showElement(muteButton);
   showElement(stillButton);
   hideElement(callDiv);
