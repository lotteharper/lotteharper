<!doctype html> <html lang="{{ lang }}">
{% load feed_filters %}
{% load app_filters %}
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="{{ description|trans }}">
    <meta name="author" content="{{ author_name }}">
    <link rel="icon" href="/media/favicon.ico">
    <title>{% if title %}{{ title }} - {% endif %}{{ site_name }}</title>
    <link rel="canonical" href="https://glamgirlx.com{{ path }}">
    <link href="/static/main.css" rel="stylesheet">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    <link rel="stylesheet" href="/static/fonts/bootstrap-icons.css">
    {% block head %}{% endblock %}
    {% include 'google_adsense_head_code.html' %}
