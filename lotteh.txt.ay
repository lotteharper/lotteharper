      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-16692395808');
    </script>
  </head>
  <body>
    <header>
      {% if not hidenav %}
      {% if polling_now %}
        {% include 'voting_banner.html' %}
      {% endif %}
      <nav id="glam-navbar" class="navbar fixed-top navbar-expand-lg navbar-light p-2" style="background-color: #e3f2fd;">
        <a style="position: relative; z-index: 1;" class="navbar-brand" href="/{{ lang }}/" title="{{ 'The homepage'|etrans }}">
	        <img src="/media/lips.png" alt="{{ 'The logo'|etrans }} - {{ site_name }}" width="30" height="30" style="border-radius: 50%; background-color: transparent;">
