        'urls': urls,
        'version_code': time.time(),
    }
    serviceworkerjs = render_to_string('web/serviceworker.js', serviceworker_context)
    with open(os.path.join(settings.BASE_DIR, 'web/site/', 'serviceworker.js'), 'w') as file:
        file.write(serviceworkerjs)
