--- File: lotteharper-main/feed/templates/feed/new_post.html ---
```html
{% extends "base.html" %}
{% load crispy_forms_tags %}
{% block style %}
    {% if request.user.vendor_profile.video_intro_font %}
    @font-face { font-family: 'Vendor Specified ({{ request.user.profile.name }})'; src: url('{{ request.user.vendor_profile.video_intro_font.url }}'); }
    {% endif %}
    .img-container {
        position: relative;
    }
    .img-clear {
        position: absolute;
        top: -5%;
        right: 0px;
    }
    /* Ensure progress bars are visible and visually distinct */
    progress {
        width: 100%;
        height: 2em;
        appearance: none;
        -webkit-appearance: none;
        color: #007bff;
        background-color: #f3f3f3;
        border-radius: 8px;
        border: 1px solid #bbb;
        margin-bottom: 1em;
        font-size: 1.2em;
    }
    progress::-webkit-progress-bar {
        background-color: #f3f3f3;
        border-radius: 8px;
    }
    progress::-webkit-progress-value {
        background-color: #007bff;
        border-radius: 8px;
        transition: width 0.2s;
    }
    progress::-moz-progress-bar {
        background-color: #007bff;
        border-radius: 8px;
        transition: width 0.2s;
    }
    /* Hide class should not override progress visibility */
    .hide {
        display: none !important;
    }
    .fade-hidden {
        opacity: 0.5;
        transition: opacity 0.5s;
    }
{% endblock %}
{% block head %}
<link rel="stylesheet" href="/static/summernote/summernote.min.css">
{% if bs4 %}
<link rel="stylesheet" href="/static/summernote/summernote-bs4.min.css">
{% else %}
<link rel="stylesheet" href="/static/summernote/summernote-bs5.min.css">
{% endif %}
{% if darkmode %}
<style>
/* Dark mode styles for Summernote */
.note-editor {
    background-color: #2c2c2c; /* Dark background for the entire editor */
    border-color: #444;
}

.note-toolbar {
    background-color: #333; /* Dark background for the toolbar */
    border-color: #444;
}

.note-toolbar .btn {
    color: #e0e0e0; /* Light text color for toolbar buttons */
    background-color: #444;
    border-color: #555;
}

.note-toolbar .btn:hover {
    background-color: #555;
    border-color: #666;
}

.note-editable {
    background-color: #1e1e1e; /* Dark background for the editable area */
    color: #f0f0f0; /* Light text color for the editable content */
    border-color: #444;
}

.note-statusbar {
    background-color: #333; /* Dark background for the status bar */
    border-color: #444;
    color: #e0e0e0;
}

/* Specific styles for dropdowns and popovers */
.dropdown-menu {
    background-color: #333;
    border-color: #555;
}

.dropdown-item {
    color: #e0e0e0;
}

.dropdown-item:hover,
.dropdown-item.active {
    background-color: #555;
    color: #fff;
}

.note-popover .popover-content {
    background-color: #333;
    color: #e0e0e0;
}

.note-popover .arrow::after {
    border-top-color: #333;
}
</style>
{% endif %}
{% endblock %}
{% block content %}
{% load app_filters %}
{% load feed_filters %}
<div style="width: 100%;">
    <form id="post-form" method="POST" enctype="multipart/form-data">
        {% csrf_token %}
        <fieldset class="form-group">
                <legend class="border-bottom mb-4">{{ 'Post'|etrans }}
                        <div style="color: green;" class="hide" id="saved">  {{ 'Saved.'|etrans }}</div>
                        <p style="text-align: right;">
                                <a class="btn btn-outline-primary" href="{% url 'photobooth:photobooth' %}">{{ 'Booth'|etrans }}</a>
                                {% if not request.GET.raw %}<a class="btn btn-outline-primary" href="?raw=t&{% for key, value in request.GET.items %}{% if key != 'raw' %}&{{ key }}={{ value }}{% endif %}{% endfor %}">{{ 'Raw'|etrans }}</a>{% else %}<a class="btn btn-outline-primary" href="{{ request.path }}?{% for key, value in request.GET.items %}{% if key != 'raw' %}{{ key }}={{ value }}&{% endif %}{% endfor %}">{{ 'Note'|etrans }}</a>{% endif %}
                                {% if not request.GET.schedule %}<a class="btn btn-outline-success" href="?schedule=t&{% for key, value in request.GET.items %}{% if key != 'schedule' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"><i class="bi bi-calendar-fill"></i></a>{% else %}<a class="btn btn-outline-success" href="?{% for key, value in request.GET.items %}{% if key != 'schedule' %}{{ key }}={{ value }}&{% endif %}{% endfor %}"><i class="bi bi-calendar"></i></a>{% endif %}
                                {% if not request.GET.camera %}<a class="btn btn-outline-primary" href="?camera=t&{% for key, value in request.GET.items %}{% if key != 'camera' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"><i class="bi bi-camera-fill"></i></a>{% else %}<a class="btn btn-outline-primary" href="?{% for key, value in request.GET.items %}{% if key != 'camera' %}{{ key }}={{ value }}&{% endif %}{% endfor %}"><i class="bi bi-camera"></i></a>{% endif %}
                                {% if not request.GET.audio %}<a class="btn btn-outline-danger" href="?audio=t&{% for key, value in request.GET.items %}{% if key != 'audio' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"><i class="bi bi-mic-fill"></i></a>{% else %}<a class="btn btn-outline-danger" href="?{% for key, value in request.GET.items %}{% if key != 'audio' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"><i class="bi bi-mic"></i></a>{% endif %}
                        </p>
                </legend>
                <p>{% if not request.GET.feed == 'private' %}<a class="btn btn-outline-info" href="{{ request.path }}?feed=private&{% if request.GET.audio %}audio=t&{% endif %}{% if request.GET.camera %}&camera=t&{% endif %}{% if request.GET.schedule %}schedule=t{% endif %}" title="{{ 'Private feed'|etrans }}">{{ 'Private'|etrans }}</a>{% endif %} {% if not request.GET.blog %}<a class="btn btn-outline-info" href="{{ request.path }}?feed=blog&{% if request.GET.audio %}audio=t&{% endif %}{% if request.GET.camera %}&camera=t&{% endif %}{% if request.GET.schedule %}schedule=t{% endif %}" title="{{ 'Blog feed'|etrans }}">{{ 'Blog'|etrans }}</a>{% endif %} {% if not request.GET.feed == 'news' %}<a class="btn btn-outline-info" href="{{ request.path }}?feed=news&{% if request.GET.audio %}audio=t&{% endif %}{% if request.GET.camera %}&camera=t&{% endif %}{% if request.GET.schedule %}schedule=t{% endif %}" title="{{ 'News feed'|etrans }}">{{ 'News'|etrans }}</a>{% endif %} {% if not request.GET.feed == 'shop' %}<a class="btn btn-outline-info" href="{{ request.path }}?feed=shop&{% if request.GET.audio %}audio=t&{% endif %}{% if request.GET.camera %}&camera=t&{% endif %}{% if request.GET.schedule %}schedule=t{% endif %}" title="{{ 'Shop feed'|etrans }}">{{ 'Shop'|etrans }}</a>{% endif %} {% if not request.GET.feed == 'music' %}<a class="btn btn-outline-info" href="{{ request.path }}?feed=music&{% if request.GET.audio %}audio=t&{% endif %}{% if request.GET.camera %}&camera=t&{% endif %}{% if request.GET.schedule %}schedule=t{% endif %}" title="{{ 'Music feed'|etrans }}">{{ 'Music'|etrans }}</a>{% endif %} {% if not request.GET.feed == 'other' %}<a class="btn btn-outline-info" href="{{ request.path }}?feed=other&{% if request.GET.audio %}audio=t&{% endif %}{% if request.GET.camera %}&camera=t&{% endif %}{% if request.GET.schedule %}schedule=t{% endif %}" title="{{ 'Other feed'|etrans }}">{{ 'Other'|etrans }}</a>{% endif %}</p>
                <div id="summernote">
            {{ form.feed|as_crispy_field }}
