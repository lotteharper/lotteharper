        context['title'] = translate(request, 'News', lang, 'en')
        news = render_to_string('web/news.html', context)
        with open(os.path.join(settings.BASE_DIR, 'web/site/', '{}/news.html'.format(lang)), 'w') as file:
            file.write(news)
