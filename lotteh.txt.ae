{% if profile.user.vendor_profile.video_link %}<a class="btn btn-dark btn-lg border border-dark" target="_blank" href="{% url 'vendors:video' profile.name %}" title="{{ 'Video (for all ages)'|etrans }}">{{ 'Video'|etrans }}</a>{% endif %}
{% endif %}
<a class="btn btn-success btn-lg" href="{% url 'payments:tip-crypto-simple' profile.name %}" title="{{ 'Tip me with cryptocurrency'|etrans }}">{{ 'Tip'|etrans }}</a>
{% if profile.user.vendor_profile.activate_surrogacy %}<a class="btn btn-light btn-lg border border-dark" href="{% url 'payments:surrogacy' profile.name %}" title="{{ 'Surrogacy plans'|etrans }}">{{ 'Surrogacy'|etrans }}</a>{% endif %}
<a class="btn btn-danger btn-lg" href="{% url 'chat:video' %}" title="{{ 'Video chat'|etrans }}">{{ 'Video Chat'|etrans }}</a>
</p>
{% endif %}
```


