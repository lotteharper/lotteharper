        <a style="position: relative; z-index: 1;" class="navbar-brand" href="/{{ lang }}/" title="{{ 'The homepage'|etrans }}">
	        <img src="/media/lips.png" alt="{{ 'The logo'|etrans }} - {{ site_name }}" width="30" height="30" style="border-radius: 50%; background-color: transparent;">
	    	{{ site_name }}
    	</a>
        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" data-bs-auto-close="true" data-bs-toggle="dropdown" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        {% load feed_filters %}
        {% load app_filters %}
        <div class="collapse navbar-collapse " id="navbarSupportedContent">
          <ul class="navbar-nav mr-auto">
            <li class="nav-item">
              <a class="nav-link" href="/{{ lang }}/news" title="{{ 'New articles'|etrans }}">{{ 'News'|etrans }}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/{{ lang }}/contact" title="{{ 'Contact me'|etrans }}">{{ 'Contact'|etrans }}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/{{ lang }}/landing" title="{{ 'Visit the landing page'|etrans }}">{{ 'Landing'|etrans }}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/{{ lang }}/chat" title="{{ 'Video chat'|etrans }}">{{ 'Chat'|etrans }}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/{{ lang }}/private" title="{{ 'See private photos with a key'|etrans }}">{{ 'Private'|etrans }}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ site_url }}{% url 'payments:surrogacy' model_name %}?lang={{ lang }}" title="Surrogacy plans">{{ 'Surrogacy'|etrans }}</a>
            </li>
          </ul>
          <ul class="navbar-nav" style="margin-left: auto;">
            <form class="form-inline d-flex mt-2 mt-md-0" action="{{ site_url }}/search/" method="GET">
              <input class="form-control hide" type="text" id="lang" name="lang" value="{{ lang }}">
              <input class="form-control mr-sm-2" type="text" id="q" name="q" placeholder="{{ 'Search'|etrans }}" aria-label="{{ 'Search'|etrans }}" required>
              <button class="btn btn-outline-success my-2 my-sm-0" type="submit" title="{{ 'Search my website,'|etrans }} {{ base_domain }}">{{ 'Search'|etrans }}</button>
            </form>
