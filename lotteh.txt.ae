<legend style="text-align: center;"><a href="tel:{{ main_phone|phone_number }}" title="{{ 'Call my phone,'|etrans }} {{ main_phone|phone_number }}"><i class="bi bi-telephone-outbound-fill"></i> {{ main_phone|phone_number }}</a>  <a href="tel:{{ main_phone|phone_number }}" title="{{ 'Call my phone,'|etrans }} {{ main_phone|phone_number }}"> {{ main_phone|character_phone_number }}</a></legend>
<legend>{% blocktrans en %}My pronouns are {{ profile.user.vendor_profile.pronouns|pronouns }}{% endblocktrans %}</legend>
{% with profile.user as theuser %}
{% include 'signature.html' %}
{% endwith %}
{% autoescape off %}
<p>{{ profile.id|transbio|addhttpstodomains|embedlinks|tagusers }}</p>
{% endautoescape %}
<p style="text-align:center;"><small class="text-muted">{{ 'Last Seen'|etrans }}: {{ profile.last_seen|date:"F d, Y" }} {{ profile.last_seen|time:"H:i" }}</small> - <small class="text-muted"> {{ 'Joined'|etrans }}: {{ profile.date_joined|date:"F d, Y" }} {{ profile.date_joined|time:"H:i" }}</small></p>
<div class="d-flex">{% with profile as content %}{% include 'clock.html' %}{% endwith %}</div>
{% if user.is_authenticated %}
{% if False %}
<div style="text-align:center;">
<h2>{{ 'Live Feed'|etrans }}</h2>
<iframe id="live" src="/stream/{{ profile.name }}/?hidenavbar=t{% if request.GET.lang %}&lang={{ request.GET.lang }}{% endif %}" width="100%" height="400px"></iframe>
</div>
{% endif %}
{% blocktrans en %}
{% if not request.GET.likes %}
<p>{{ 'Displaying all public posts.' }}</p>
{% else %}
<p>{{ 'Displaying posts you like.' }} <a href="{{ request.path }}" class="btn btn-sm btn-outline-success" title="{{ 'All posts by' }} @{{ profile.name }}">{{ 'See everything' }}</a></p>
{% endif %}
{% endblocktrans %}
<hr style="background-color: pink;" class="mb-5">
{% endif %}
{% endif %}
```


