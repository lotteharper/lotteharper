--- File: lotteharper-main/feed/templates/feed/post_edit_form.html ---
```html
{% extends "base.html" %}
{% load crispy_forms_tags %}
{% block head %}
<link rel="stylesheet" href="/static/summernote/summernote.min.css">
{% if bs4 %}
<link rel="stylesheet" href="/static/summernote/summernote-bs4.min.css">
{% else %}
<link rel="stylesheet" href="/static/summernote/summernote-bs5.min.css">
{% endif %}
{% if nudity_censor %}
<script src="/static/js/tensorflow.min.js"></script>
<script src="/static/js/nsfwjs.min.js"></script>
{% endif %}
<style>
{% if request.user.vendor_profile.video_intro_font %}
@font-face { font-family: 'Vendor Specified ({{ request.user.profile.name }})'; src: url('{{ request.user.vendor_profile.video_intro_font.url }}'); }
{% endif %}
</style>
{% if darkmode %}
<style>
/* Dark mode styles for Summernote */
.note-editor {
    background-color: #2c2c2c; /* Dark background for the entire editor */
    border-color: #444;
}

.note-toolbar {
    background-color: #333; /* Dark background for the toolbar */
    border-color: #444;
}

.note-toolbar .btn {
    color: #e0e0e0; /* Light text color for toolbar buttons */
    background-color: #444;
    border-color: #555;
}

.note-toolbar .btn:hover {
    background-color: #555;
    border-color: #666;
}

.note-editable {
    background-color: #1e1e1e; /* Dark background for the editable area */
    color: #f0f0f0; /* Light text color for the editable content */
    border-color: #444;
}

.note-statusbar {
    background-color: #333; /* Dark background for the status bar */
    border-color: #444;
    color: #e0e0e0;
}

/* Specific styles for dropdowns and popovers */
.dropdown-menu {
    background-color: #333;
    border-color: #555;
}

.dropdown-item {
    color: #e0e0e0;
}

.dropdown-item:hover,
.dropdown-item.active {
    background-color: #555;
    color: #fff;
}

.note-popover .popover-content {
    background-color: #333;
    color: #e0e0e0;
}

.note-popover .arrow::after {
    border-top-color: #333;
}
</style>
{% endif %}
{% endblock %}
{% block content %}
{% load app_filters %}
       <form method="POST" enctype="multipart/form-data">
            {% csrf_token %}
            <fieldset class="form-group">
                <legend class="border-bottom mb-4">{{ 'Update Post'|etrans }}
		{% if form.instance %}
		<div style="text-align: right;">
			<button type="submit" class="btn btn-outline-info">{{ 'Update'|etrans }}</button>
			<a style="float: right;" href="{% url 'feed:post-delete' pk=form.instance.id %}" title="{{ 'Delete this post'|etrans }}"><button type="button" class="btn btn-danger"><i class="bi bi-x-circle-fill"></i> {{ 'Delete'|etrans }}</button></a>
		</div>
		{% endif %}
		</legend>
                {{ form|crispy }}
            </fieldset>
            <img id="image-to-upload"></img>
            <hr>
            <p id="contentLength"></p>
            <div class="form-group">
                <button class="btn btn-outline-info" type="submit" id="edit-form-submit">{{ 'Post'|etrans }}</button>
            </div>
        </form>
        <hr>
	{% if form.instance.image %}
	<img id="image-to-upload" width="100%;" src="{{ form.instance.get_image_url }}"></img>
	<div style="display: flex; justify-content: space-around;">
	<form method="POST" action="{% url 'feed:rotate' pk=form.instance.id direction='left' %}">
		{% csrf_token %}
		<button type="submit" class="btn btn-outline-secondary">{{ 'Rotate Left'|etrans }}</button>
	</form>
	<form method="POST" action="{% url 'feed:rotate' pk=form.instance.id direction='flip' %}">
		{% csrf_token %}
		<button type="submit" class="btn btn-outline-secondary">{{ 'Flip 180°'|etrans }}</button>
	</form>
	<form method="POST" action="{% url 'feed:rotate' pk=form.instance.id direction='right' %}">
		{% csrf_token %}
		<button type="submit" class="btn btn-outline-secondary">{{ 'Rotate Right'|etrans }}</button>
	</form>
	</div>
	{% endif %}
<script src="/static/summernote/summernote.min.js"></script>
{% endblock %}
{% block javascripts %}
{% if bs4 %}
<script src="/static/summernote/summernote-bs4.min.js"></script>
{% else %}
<script src="/static/summernote/summernote-bs5.min.js"></script>
{% endif %}
{{ form.media }}
{% endblock %}
{% block javascript %}
{% if not request.GET.raw %}
var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'))
var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
    return new bootstrap.Dropdown(dropdownToggleEl)
});
{% endif %}
var chooseFile = document.getElementById("id_image");
var imgPreview = document.getElementById("image-to-upload");
chooseFile.addEventListener("change", function () {
    getImgData();
});
function getImgData() {
    imgPreview.innerHTML = "";
    chooseFileFiles = Array.from(chooseFile.files);
    const files = chooseFile.files[0];
    if (files) {
    {% if nudity_censor %}    document.getElementById('edit-form-submit').disabled = true;{% endif %}
        for(var x = 0; x < chooseFile.files.length; x++) {
            var fileReader = new FileReader();
            fileReader.index = x;
            fileReader.readAsDataURL(chooseFile.files[x]);
            fileReader.addEventListener("load", function(evt) {
                imgPreview.src = this.result;
            });
        }
    }
}
{% if nudity_censor %}
const cvcanvas = document.getElementById('cvcanvas');
const cvctx = cvcanvas.getContext('2d');
var nsfwjsmodel;
nsfwjs.load('/static/js/models/mobilenet_v2/').then(function(model) {
    nsfwjsmodel = model;
});
function detectImage(image_id) {
    var image = document.getElementById(image_id);
    cvcanvas.width = Math.trunc(image.naturalWidth * {{ nudity_censor_scale }});
    cvcanvas.height = Math.trunc(image.naturalHeight * {{ nudity_censor_scale }});
    cvctx.clearRect(0, 0, cvcanvas.width, cvcanvas.height);
    cvctx.drawImage(image, 0, 0, Math.trunc(image.naturalWidth * {{ nudity_censor_scale }}), Math.trunc(image.naturalHeight * {{ nudity_censor_scale }}));
    nsfwjsmodel.classify(cvcanvas, 1).then(function (predictions) {
        if(predictions[0].className == 'Porn' && predictions[0].probability > 0.95) {
            chooseFile.value = '';
            document.getElementById('image-to-upload').src = '';
        } else {
            document.getElementById('edit-form-submit').disabled = false;
        }
    });
}
{% endif %}
$(document).ready(function() {
    {% if not request.GET.raw %}
    function onSummernoteInit() {
        $('[data-toggle="dropdown"]').each(function(index, el) {
            el.dataset.bsToggle = "dropdown";
        });
        {% if not darkmode %}
        const summernoteElement = document.getElementById('id_content');
        if (summernoteElement) {
            function getAllTextNodes(element) {
              const textNodes = [];

              function traverse(node) {
                // Check if the node is a text node
                if (node.nodeType === Node.TEXT_NODE) {
                  // Add the trimmed text content to the array
                  const textContent = node.nodeValue.trim();
                  if (textContent.length > 0) { // Only add non-empty text
                    textNodes.push(node);
                  }
                } else {
                  // Recursively traverse child nodes
                  for (const childNode of node.childNodes) {
                    traverse(childNode);
                  }
                }
              }

              traverse(element);
              return textNodes;
            }
          const iElements = getAllTextNodes(summernoteElement);
          for (let i = 0; i < iElements.length; i++) {
            const currentIElement = iElements[i];
            currentIElement.style = "color: black !important;";
            console.log(currentIElement);
          }
        } else {
          console.log("Element with ID 'summernote' not found.");
        }
        {% else %}
        function getAllChildElements(parentElement) {
          const children = [];
          function traverse(node) {
            for (let i = 0; i < node.children.length; i++) {
              const childElement = node.children[i];
              if(childElement.tagName != 'BUTTON' && childElement.tagName != 'OPTION' && childElement.tagName != 'DIV' && childElement.tagName != 'I' && childElement.tagName != 'INPUT' && childElement.tagName != 'TEXTAREA' && childElement.tagName != 'LABEL' && childElement.tagName != 'SPAN' && childElement.tagName != 'A' && !childElement.classList.contains('note-btn-group') && !childElement.classList.contains('form-group') && !childElement.classList.contains('form-check') && !childElement.classList.contains('select') && !childElement.classList.contains('form-check-label')) {
                children.push(childElement);
              } else if (((childElement.tagName == 'LABEL' && (childElement.classList.contains('note-form-label') || childElement.classList.contains('form-check-label'))) || (childElement.tagName == 'INPUT' && childElement.classList.contains('note-image-input'))) && !childElement.getAttribute('FOR').startsWith('id_')) {
                children.push(childElement);
              } else if(childElement.tagName != 'TEXTAREA' && childElement.tagName != 'INPUT') {
                traverse(childElement);
              }
            }
          }
          traverse(parentElement); // Start the traversal from the initial parent
          return children;
        }
        const bodyChildren = getAllChildElements(document.getElementById('id_content'));
        for (let i = 0; i < bodyChildren.length; i++) {
            const currentIElement = bodyChildren[i];
            currentIElement.style = "color: black !important;";
            console.log(currentIElement);
        }
        {% endif %}
    }
    $(document).on('summernote.init', '#id_content', onSummernoteInit);
    $('#id_content').summernote({
        fontNames: ['Arial', 'Arial Black', 'Comic Sans MS', 'Courier New'{% if request.user.vendor_profile.video_intro_font %}, 'Vendor Specified ({{ request.user.profile.name }})'{% endif %}],
        {% if request.user.vendor_profile.video_intro_font %}        fontNamesIgnoreCheck: ['Vendor Specified ({{ request.user.profile.name }})'],{% endif %}
        toolbar: [
            ['style', ['style']],
            ['font', ['bold', 'italic', 'underline', 'clear']],
            ['font', ['fontname', 'fontsize', 'color']],
            ['para', ['ul', 'ol', 'paragraph']],
            ['height', ['height']],
            ['table', ['table']],
            ['insert', ['link', 'picture', 'video', 'hr']],
            ['view', ['fullscreen', 'codeview', 'help']],
            ['misc', ['undo', 'redo']]
        ],
    });
    {% endif %}
});
{% endblock %}
```


--- File: lotteharper-main/feed/templates/feed/_post.html ---
```html
{% if post and post.id %}
{% load feed_filters %}
<div>
    <img src="{% if profile_url %}{{ profile_url }}{% else %}{% if post.author in request.user.profile.subscriptions.all %}{{ post.author.profile.get_image_url }}{% else %}{{ post.author.profile.get_face_blur_url }}{% endif %}{% endif %}" alt="@{{ post.author.profile.name }}'s {{ 'profile photo'|etrans }}" width="120" height="120" align="left" style="margin-top:5px; margin-right:10px; margin-bottom:10px; border-radius: 50%;"/>
    <div class="article-metadata">
      <a class="mr-2" href="{% url 'feed:profile' username=post.author.profile.name %}" title="{{ 'See'|etrans }} @{{ post.author.profile.name }}'s {{ 'profile'|etrans }}">@{{ post.author.profile.name }}</a>
      {% with post as content %}
        {% include 'clock.html' %}
      {% endwith %}
      <small class="text-muted">{% blocktrans en %}{{ post.date_posted|date:"F d, Y" }}{% endblocktrans %} {{ post.date_posted|time:"H:i" }}</small>
      <small class="text-muted">#{{ post.id }} <i class="bi bi-translate"></i> {{ post.content|detectlanguage }}</small>
      <small>{% if post.pinned %}<i class="bi bi-pin-angle-fill"></i>{% else %}<i class="bi bi-pin-fill"></i>{% endif %}</small>
      {% if post.likes.count > 0 %}<small><i class="bi bi-heart-fill"></i> {{ post.likes.count|nts|etrans }}</small>{% endif %}
      {% if post.recipient == request.user %}<small><i>{{ 'Private'|etrans }}</i></small>{% endif %}
      <div style="float: right; display: inline-block;"><button onclick="reportContent('{{ post.uuid }}');" class="btn btn-sm btn-outline-danger" title="{{ 'Report this content'|trans }}">{{ 'Report'|etrans }}</button></div>
    </div>
    {% autoescape off %}    
    {% if request.path == '/search/' %}
    <p class="article-content">{{ post.content|trimlength|markdowntohtml|transauthor:post.id|tagusers|highlightsearchquery }}</p>
    {% elif post.content|isabook %}
    <p class="article-content">{{ post.content_compiled|trimlength|transauthor:post.id|tagusers }}</p>
    {% else %}
    <p class="article-content">{{ post.content|trimlength|markdowntohtml|transauthor:post.id|addhttpstodomains|embedlinks|tagusers }}</p>
    {% endif %}
    {% if post.content|isabook %}
    {% include 'reader.html' %}
    {% endif %}
    {% endautoescape %} 
    {% if post.image %} 
        {% if not post.public and not request.GET.show and not post.author in request.user.profile.subscriptions.all %}
        {% with post.get_blur_thumb_url as imurl %}
       <a title="A post by @{{ post.author.profile.name }}"><img src="{{ imurl }}" class="img-fluid post-image" style="width:100%;" alt="{% if post.content|geturl == "" %}View the photo from a post by {% else %}Vist the link posted by {% endif %}@{{ post.author.profile.name }}"></a>
        {% endwith %}
        {% elif post.public or post.author == request.user or post.recipient == request.user or post.author in request.user.profile.subscriptions.all %}
        {% with post.get_image_url as imurl %}
       <a title="A post by @{{ post.author.profile.name }}"><img src="{{ imurl }}" class="img-fluid post-image" style="width:100%;" alt="{% if post.content|geturl == "" %}View the photo from a post by {% else %}Vist the link posted by {% endif %}@{{ post.author.profile.name }}"></a>
        {% endwith %}
        {% elif post.author in request.user.profile.subscriptions.all %}
        {% with post.get_image_url as imurl %}
       <a title="A post by @{{ post.author.profile.name }}"><img src="{{ imurl }}" class="img-fluid post-image" style="width:100%;" alt="{% if post.content|geturl == "" %}View the photo from a post by {% else %}Vist the link posted by {% endif %}@{{ post.author.profile.name }}"></a>
        {% endwith %}
        {% elif not post.public %}
        {% with post.get_blur_thumb_url as imurl %}
       <a href="{% if not post.content|geturl == "" %}{{ post.content|geturl }}{% else %}{{ imurl }}{% endif %}" title="A post by @{{ post.author.profile.name }}"><img src="{{ imurl }}" class="img-fluid post-image" style="width:100%; filter: blur(8px);" alt="{% if post.content|geturl == "" %}View the photo from a post by {% else %}Vist the link posted by {% endif %}@{{ post.author.profile.name }}"></a>
        {% endwith %}
        {% elif post.public %}
        {% with post.get_face_blur_thumb_url as imurl %}
       <a title="A post by @{{ post.author.profile.name }}"><img src="{{ imurl }}" class="img-fluid post-image" style="width:100%;" alt="{% if post.content|geturl == "" %}View the photo from a post by {% else %}Vist the link posted by {% endif %}@{{ post.author.profile.name }}"></a>
        {% endwith %}
        {% elif request.user == post.author %}
        {% with post.get_blur_url as imurl %}
       <a href="{% if not post.content|geturl == "" %}{{ post.content|geturl }}{% else %}{{ imurl }}{% endif %}" title="A post by @{{ post.author.profile.name }}"><img src="{{ imurl }}" class="img-fluid post-image" style="width:100%;" alt="{% if post.content|geturl == "" %}View the photo from a post by {% else %}Vist the link posted by {% endif %}@{{ post.author.profile.name }}"></a>
        {% endwith %}
        {% endif %} 
    {% endif %}
    {% if post.file_bucket %}
        {% if post.paid_file and not request.user in post.paid_users.all and post.file_bucket.name|filetype == 'docx' or post.file_bucket.name|filetype == 'pdf' or post.file_bucket.name|filetype == 'zip' %}
            <p> {{ 'This post contains a paid downloadable file in'|etrans }} .{{ post.file_bucket.name|filetype }} {{ 'format. Please buy the post in order to download the file.'|etrans }}</p>
        {% elif post.paid_file and not request.user in post.paid_users.all %}
            <p>Please buy this post to hear the full version of the audio.</p>
            <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}" apid="{{ post.id }}" page="{% if request.GET.page %}{{ request.GET.page }}{% else %}{{ num_pages }}{% endif %}">
          	<source src="{{ post.get_file_sample }}" type="audio/mpeg">
        	Your browser does not support the audio element.
            </audio>
        {% elif not post.paid_file or request.user in post.paid_users.all %}
            {% if not post.private or post.public and document_scanned %}<p>{{ 'This post contains a downloadable file in'|etrans }} .{{ post.file_bucket.name|filetype }} {{ 'format'|etrans }}. <a title="Download this file" href="{{ post.get_file_url }}" class="btn btn-outline-danger btn-sm">Download</a></p>{% endif %}
            {% if post.file_bucket.name|filetype == 'mp3' %}
            <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}" apid="{{ post.id }}" page="{% if request.GET.page %}{{ request.GET.page }}{% else %}{{ num_pages }}{% endif %}">
          	<source src="{{ post.get_file_url }}" type="audio/mpeg">
        	    {{ 'Your browser does not support the audio element.'|etrans }}
            </audio>
            {% elif post.file_bucket.name|filetype == 'wav' %}
            <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}" apid="{{ post.id }}" page="{% if request.GET.page %}{{ request.GET.page }}{% else %}{{ num_pages }}{% endif %}">
          	<source src="{{ post.get_file_url }}" type="audio/wav">
        	    {{ 'Your browser does not support the audio element.'|etrans }}
            </audio>
            {% elif post.file_bucket.name|filetype == 'aac' %}
            <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}">
        	<source src="{{ post.get_file_url }}" type="audio/mp4">
        	    {{ 'Your browser does not support the audio element.'|etrans }}
            </audio>
            {% elif post.file_bucket.name|filetype == 'webm' %}
            <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}">
        	<source src="{{ post.get_file_url }}" type="audio/mp4">
        	    {{ 'Your browser does not support the audio element.'|etrans }}
            </audio>
            {% elif post.file_bucket.name|filetype == 'mp4' or post.file_bucket.name|filetype == 'mov' %}
            <video width="100%" controls preload="metadata">
                <source src="{{ post.get_file_url }}" type="video/mp4">
        	    {{ 'Your browser does not support the audio element.'|etrans }}
            </video>
            {% endif %}
        {% endif %}
    {% endif %}
    {% if post.image_sightengine %}<p>SightEngine {{ 'Image Output'|etrans }} - {{ post.image_sightengine }}</p>{% endif %}
    {% if post.file_sightengine %}<p>SightEngine {{ 'File Output'|etrans }} - {{ post.file_sightengine }}</p>{% endif %}
    <hr>
    <div style="display: inline-block;">
        {% if not request.path|startswith:'/feed/post/' %}
        <a href="{{ post.get_absolute_url }}" title="{% blocktrans %}View post{% if user.is_authenticated and post.author == user %}, or rotate photo{% endif %}{% endblocktrans %}"><button type="button" class="btn btn-primary"><i class="bi bi-binoculars-fill"></i> {{ 'View'|etrans }}</button></a>
        {% endif %}
        {% if not request.user == post.recipient %}
        {% if post.has_auction %}
        <a href="{% url 'feed:auction' post.friendly_name %}" title="{{ 'Bid on this post'|etrans }}"><button type="button" class="btn btn-primary"><i class="bi bi-currency-dollar"></i> {{ 'Bid'|etrans }}</button></a>
        {% else %}
        <button class="btn btn-outline-primary" title="{{ 'Add this to your cart'|etrans }}" onclick="addToCart('{{ post.uuid }}');">{{ 'Add to Cart'|etrans }} <i><b id="total{{ post.uuid }}"></b></i></button>
        {% if not post.private %}        <a href="{% url 'payments:buy-photo-card' post.author.profile.name %}?id={{ post.uuid }}" title="{{ 'Buy this photo'|etrans }}"><button type="button" class="btn btn-primary"><i class="bi bi-currency-dollar"></i> {{ 'Buy'|etrans }}</button></a>{% endif %}
        <a href="{% url 'payments:buy-photo-crypto' post.author.profile.name %}?id={{ post.uuid }}&crypto={{ default_crypto }}" title="{{ 'Buy this photo with cryptocurrency'|etrans }}"><button type="button" class="btn btn-primary"><i class="bi bi-currency-bitcoin"></i> {{ 'Buy with Crypto'|etrans }}</button></a>
        {% endif %}
        {% endif %}
        {% if user.is_authenticated %}
        {% if user.is_authenticated and post.author == user %}
        {% include 'feed/pin.html' %}
        {% include 'feed/publish.html' %}
        {% endif %}
        {% include 'feed/like.html' %}
        {% if request.path|startswith:'/feed/post/' or request.path|startswith:'/feed/page/' %}
        {% if user.is_authenticated and post.author == user %}
        <a href="{% url 'feed:post-update' pk=post.id %}" title="{{ 'Edit this post'|etrans }}"><button type="button" class="btn btn-secondary"><i class="bi bi-pencil-fill"></i> {{ 'Edit'|etrans }}</button></a>
        {% endif %}
        {% else %}
        {% if user.is_authenticated and post.author == user and post.private %}
        <button class="btn btn-info frame" data-name="{{ post.content }}"><i class="bi bi-person-lines-fill"></i> {{ 'Text'|etrans }}</button>
        {% endif %}
        {% endif %}
        {% endif %}
    </div>
    {% if user.is_authenticated and post.author == user %}
    <button class="edit-form btn btn-outline-info" id="edit{{ post.id }}"><i class="bi bi-pencil"></i></button>
    <iframe class="hide" id="iframeedit{{ post.id }}" data-src="{% url 'feed:post-update' pk=post.id %}?hidenavbar=t" title="Edit this post" width="100%" height="400px"></iframe>
    {% endif %}
</div>
<hr>
{% endif %}
```


--- File: lotteharper-main/feed/templates/feed/_post.html.save ---
```
{% load feed_filters %}
<div>
<img src="{{ post.author.profile.image.url }}?{{ post.author.profile.rotation }}" alt="@{{ post.author.username }}'s profile photo" width="120" height="120" align="left" style="margin-top:5px; margin-right:10px; margin-bottom:10px; border-radius: 50%;"/>
    <div class="article-metadata">
      <a class="mr-2" href="{% url 'feed:profile' username=post.author.username %}" title="See @{{ post.author.username }}'s profile">@{{ post.author }}</a>
      <small class="text-muted">{{ post.date_posted|date:"F d, Y" }} {{ post.date_posted|time:"H:i" }}</small>
      <small class="text-muted"><i class="bi bi-translate"></i> {{ post.content|detectlanguage }}</small>
    </div>
    {% autoescape off %}    
    {% if request.path == '/search/' %}
    <p class="article-content">{{ post.content|highlightsearchquery|addhttpstodomains|embedlinks|tagusers }}</p>
    {% else %}
    <p class="article-content">{{ post.content|addhttpstodomains|embedlinks|tagusers }}</p>
    {% endif %}
    {% endautoescape %}

    {% if post.image %}
    <a href="{% if not post.content|geturl == "" %}{{ post.content|geturl }}{% else %}{{ post.image.url }}{% endif %}" title="A post by @{{ post.author.username }}"><img src="{{ post.image.url }}?{{ post.rotation }}" class="img-fluid" style="width:100%;" alt="{% if post.content|geturl == "" %}View the photo from a post by {% else %}Vist the link posted by {% endif %}@{{ post.author.username }}"></a>
    {% endif %}

    {% if post.file %}
    {% if post.file.name|filetype == 'mp3' %}
    <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}" apid="{{ post.id }}" page="{% if request.GET.page %}{{ request.GET.page }}{% else %}{{ num_pages }}{% endif %}">
  	<source src="{{ post.file.url }}" type="audio/mpeg">
	Your browser does not support the audio element.
    </audio>
    {% elif post.file.name|filetype == 'wav' %}
    <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}" apid="{{ post.id }}" page="{% if request.GET.page %}{{ request.GET.page }}{% else %}{{ num_pages }}{% endif %}">
  	<source src="{{ post.file.url }}" type="audio/wav">
	Your browser does not support the audio element.
    </audio>
    {% elif post.file.name|filetype == 'aac' %}
    <audio controls style="width: 100%;" preload="metadata" id="audio{{ post.id }}">
	<source src="{{ post.file.url }}" type="audio/mp4">
        Your browser does not support the audio element.
    </audio>
    {% elif post.file.name|filetype == 'mp4' or post.file.name|filetype == 'mov' %}
    <video width="100%" controls preload="metadata">
        <source src="{{ post.file.url }}" type="video/mp4">
        Your browser does not support the video tag.
    </video>
    {% else %}
    <p>This post contains an unsupported file which is not being displayed.</p>
    {% endif %}
    {% endif %}
<hr>
<a href="{% url 'feed:post-detail' pk=post.id %}" title="View post{% if user.is_authenticated and post.author == user %}, or rotate photo{% endif %}"><button type="button" class="btn btn-primary"><i class="bi bi-binoculars-fill"></i> View</button></a>
{% if user.is_authenticated and post.author == user %}
<a href="{% url 'feed:post-update' pk=post.id %}" title="Edit this post"><button type="button" class="btn btn-secondary"><i class="bi bi-pencil-fill"></i> Edit</button></a>
{% endif %}
{% if user.is_authenticated and post.author == user or user.is_superuser %}
<a href="{% url 'feed:post-delete' pk=post.id %}" title="Delete this post"><button type="button" class="btn btn-danger"><i class="bi bi-x-circle-fill"></i> Delete</button></a>
{% endif %}
</div>
<hr>
```


--- File: lotteharper-main/feed/templates/feed/private.html ---
```html
{% extends 'base.html' %}
{% block content %}
{% load app_filters %}
<div class="content">
{% if request.GET.page == None or request.GET.page == '1' %}
<h1 style="text-align:center;">@{{ profile.name }}</h1>
<p style="text-align:center;"><small class="text-muted">Last Seen: {{ profile.last_seen|date:"F d, Y" }} {{ profile.last_seen|time:"H:i" }}</small> - <small class="text-muted"> Joined: {{ profile.date_joined|date:"F d, Y" }} {{ profile.date_joined|time:"H:i" }}</small></p>
<hr style="background-color: red;" class="mb-5">
{% endif %}
{% for post in posts %}
{% include 'feed/_post.html' %}
{% endfor %}
{% include 'pagelinks.html' %}
</div>
<div class="container">
<div style="position: fixed; left: 0; top: 0; background-color: #ffcccc; width: 100%; height: 100%;" class="cmodal hide">
<div class="hide" id="large-frame"></div>
<h1 id="current-text" style="font-size: 60px; word-wrap: break-word; text-align: center; position: relative; top: 50%; left: 50%; transform: translate(-50%, -50%);">(Tap the screen)</h1>
</div>
</div>
{% endblock %}
{% block javascript %}
var text = [];
var index = 0;
var next = true;
$('.frame').click(function(e) {
  $(document.getElementById("clemn-navbar")).autoHidingNavbar().toggleClass("hide");
  $('.cmodal').removeClass('hide');
  $('.content').addClass('hide');
  document.getElementById('large-frame').innerHTML = e.target.dataset.name;
  e.preventDefault();
  index = 0;
});
$('.cmodal').click(function(e) {
  text = document.getElementById("large-frame").innerHTML.split('\n');
  if(index < text.length){
	if(next) {
		next = false;
		$('#current-text').toggleClass('fade-hidden-fast');
		setTimeout(function() {
			$('#current-text').toggleClass('fade-in-fast');
			$('#current-text').toggleClass('fade-hidden-fast');
			document.getElementById("current-text").innerHTML = text[index];
			document.getElementById("current-text").style.fontSize = ({% if private_text_large %}35{% else %}25{% endif %} * 10/Math.sqrt(text[index].length)) + "px";
			index++;
			setTimeout(function() { 
				next = true;
				$('#current-text').toggleClass('fade-in-fast');
			}, 2500);
		}, 700);
	}
  } else {
	document.getElementById("current-text").innerHTML = "";
	$('.cmodal').addClass('hide');
	$('.content').removeClass('hide');
	$(document.getElementById("clemn-navbar")).autoHidingNavbar().toggleClass("hide");
  }
  e.preventDefault();
});
function editForm() {
    var elements = document.querySelectorAll(".edit-form");
    for(var x = 0; x < elements.length; x++) {
        if(!$(elements[x]).hasClass('init')) {
                $(elements[x]).addClass('init');
        $(elements[x]).attr('last-action', new String(new Date().getTime()));
                $(elements[x]).on('click', function(event) {
            if(parseInt($(elements[x]).prop('last-action')) - new Date().getTime() > -1000) return;
            $(elements[x]).attr('last-action', new String(new Date().getTime()));
                        console.log('edit');
            var edit_iframe = document.querySelector("#iframe" + event.target.id);
            if(edit_iframe) {
                if($(edit_iframe).hasClass('hide')) {
                                    edit_iframe.src = edit_iframe.dataset.src;
                } else {
                                     edit_iframe.src = '';
                }
                $(edit_iframe).toggleClass('hide');
            }
         });
       }
    }
}
editForm();
{% endblock %}
```


