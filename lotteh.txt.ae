                    <a href="{% url 'users:password_reset' %}">{{ 'Forgot Password?'|etrans }}</a> - <label for="id_show_password">{{ 'Show'|etrans }}</label> <input id="id_show_password" class="align-middle" type="checkbox" onclick ="reveal();">
                </small>
