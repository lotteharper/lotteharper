{% load feed_filters %}
<div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; z-index: 1002;" id="center-text">
<div class="container center tap-area">
<h1><span style="background-color: {% if darkmode %}black{% else %}white{% endif %}; font-size: 50px; word-wrap: break-word; text-align: center;" class="center" id="current-text"></span></h1>
</div>
</div>
<div style="position: fixed; left: 0; top: 0; background-color: {% if darkmode %}#667788{% else %}#ccddff{% endif %}; width: 100%; height: 120%;" class="cmodal hide">
<div class="disappear">
<div style="position: absolute; left: 5px; top: 5px;">
<div><img src="{{ icon_url }}" alt="{{ the_site_name }}" align="left" width="50" height="50" style="border-radius: 50%;"> <b>{{ the_site_name }}</b></div>
</div>
<p style="margin-top: 15px; text-align: center;" id="current-text2">{{ current_time_text|etrans }}</p>
<div style="position: absolute; right: 5px; top: 5px;">
{% include 'sclock.html' %}
</div>
<div class="tap-area w-100 h-100">
<div class="pt-1" style="display: flex; justify-content: space-around">
{% for post in posts1 %}
<img width="25%" style="max-width: 40vh; max-height: 40vh;" src="{{ post.get_face_blur_thumb_url }}" alt=" {{ 'See posts like these'|etrans }}"></img>
{% endfor %}
</div>
<div class="pt-2" style="display: flex; justify-content: space-around">
{% for post in posts2 %}
<img width="25%" style="max-width: 40vh; max-height: 40vh;" src="{{ post.get_face_blur_thumb_url }}" alt="{{ 'See posts like these'|etrans }}"></img>
{% endfor %}
</div>
{% include 'banner_ad_horizontal.html' %}
<div class="hide" id="large-frame">{{ splash|etrans }}</div>
<div class="hide" id="main-window-clemn" hidden></div>
<div class="disappear" style="position: absolute; bottom: 19%; left: 10px; width: 95%;">
<img style="margin-right: 7px;" align="left" width="35" alt="The rod of Asclepius" src="/media/static/rod-of-asclepius.png"></img>
<div class="container">
<div style="white-space: pre-wrap;">
<small style="background-color: {% if darkmode %}black{% else %}white{% endif %};">* {{ 'Tap or click the screen to continue.'|etrans }}</small>
</div>
<div class="text-right" style="text-align: right;"><small style="background-color: {% if darkmode %}black{% else %}white{% endif %};">{% if request.user.is_authenticated and request.user.profile.vendor %}{{ 'Already signed up?'|etrans }} <a id="login-button" href="{% url 'go:go' %}" title="{{ 'Go somewhere useful'|etrans }}" class="btn btn-sm btn-primary">{{ 'Go'|etrans }}</a>{% elif not request.user.is_authenticated  %}<a id="login-button" href="{% url 'users:login' %}" title="{{ 'Log in to'|etrans }} {{ the_site_name }} {{ 'here'|etrans }}" class="btn btn-sm btn-primary"><i class="bi bi-door-open-fill"></i> {{ 'Login'|etrans }}</a>{% endif %}</small></div>
<small style="background-color: {% if darkmode %}black{% else %}white{% endif %};">{% if location %}{{ location }} {% endif %}
- {{ 'Property of'|etrans }} {{ the_site_name }}, {{ 'a division of'|etrans }} {{ company_name }} UBI {{ ubi }}{{ ', by'|etrans }} {{ author_name }}.
</small>
</div>
</div>
<div style="height: 40px;"></div>
</div>
</div>
```


