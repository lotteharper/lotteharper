{% if adult_content %}
{% if profile.user.vendor_profile.content_link %}<a class="btn btn-secondary btn-lg border border-dark" target="_blank" href="{% url 'verify:age' %}?next={% url 'vendors:content' profile.name %}" title="{{ 'Adult content (for adults 18+)'|etrans }}">{{ 'Adult Content'|etrans }}</a>{% endif %}
{% if profile.user.vendor_profile.video_link %}<a class="btn btn-dark btn-lg border border-dark" target="_blank" href="{% url 'verify:age' %}?next={% url 'vendors:video' profile.name %}" title="{{ 'Adult Video (for adults 18+)'|etrans }}">{{ 'Adult Video'|etrans }}</a>{% endif %}
{% else %}
