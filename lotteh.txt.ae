			<a href="{% url 'users:resend_activation' %}">{{ 'Resend Activation'|etrans }}</a> - 
			<a href="{% url 'kick:reasess' %}">{{ 'Appeal'|etrans }}</a>
		</small>
            </div>
        </form>
