var progress = [];
var progressLabel = [];
var form = document.getElementById("post-form");
var submitBtn = document.getElementById("submit-form");
var posted = document.getElementById("posted");
var saved = document.getElementById("saved");
var chooseFile = document.getElementById("id_image");
var chooseVideoFile = document.getElementById("id_file");
var imgPreview = document.getElementById("uploaded_image");
var chooseFileFiles = [];
/*var cntr = 0;*/
var changed = false;
setInterval(function() {
        if(changed) {
        changed = false;
        var form = document.getElementById("post-form");
        var data = new FormData(form);
        data.delete("image");
        data.delete("file");
    $.ajax({
        url: window.location.pathname + "?save=t",
        type: "POST",
        data: data,
        cache: false,
        contentType: false,
        processData: false,
        timeout: 1000 * 60 * 30,
        tryCount: 0,
        retryLimit: 5,
        error: (xhr, textStatus, errorThrown) => {
                this.tryCount++;
                if(this.tryCount >= this.retryLimit) return;
                $.ajax(this);
        },
        success: (data) => {
                $(saved).removeClass("hide");
                setTimeout(function() {
                        $(saved).addClass("fade-hidden");
                        setTimeout(function() {
                                $(saved).addClass("hide");
                                $(saved).removeClass("fade-hidden");
                        }, 2000);
                }, 2000);
        },
        });
        }
}, 10000);
$(document).ready(function() {
    {% if request.GET.feed %}
    document.getElementById('id_feed').value = '{{ request.GET.feed }}';
    {% endif %}
        // Fix: event delegation for dynamic elements
        $("#post-form").on('change', 'input, select, textarea', function(){
            changed = true;
        });
        document.onkeydown = function (e) {
                e = e || window.event;
                changed = true;
        };
        $("iframe").on("load", function(){
                $(document.getElementById('id_content_iframe').contentWindow.document).keydown(function(e){
                        changed = true;
                });
        });
    {% if nudity_censor %}
    $(chooseFile).change(function() {
        submitBtn.disabled = true;
    });
    {% endif %}
});
var current = 0;
function uploadFile(data, cntr) {
    var pcounter = cntr;
    progress[pcounter] = document.getElementById("progress" + pcounter);
    progressLabel[pcounter] = document.getElementById("progress-label-" + pcounter);
    var id = data.get("confirmation_id");
    $.ajax({
        xhr: function() {
            let thexhr = new window.XMLHttpRequest();
            thexhr.upload.theProgress = document.getElementById("progress-" + pcounter);
            thexhr.upload.progressLabel = document.getElementById("progress-label-" + pcounter);
            thexhr.upload.addEventListener("progress", function(evt) {
                if (evt.lengthComputable) {
                    var percentComplete = Math.floor(evt.loaded / evt.total * 100);
                    if(this.theProgress) {
                        this.theProgress.value = percentComplete;
                    }
                    if(this.progressLabel) {
                        this.progressLabel.textContent = percentComplete + '%';
                    }
                }
            });
            return thexhr;
        },
        url: window.location.pathname + "?confirmation=" + new String(data.get("confirmation_id")),
        type: "POST",
        data: data,
        contentType: false,
        processData: false,
        timeout: 1000 * 60 * 30,
        tryCount: 0,
        retryLimit: 5,
        error: (xhr, textStatus, errorThrown) => {
        console.log(errorThrown);
                $(progress[pcounter]).addClass("fade-hidden");
                setTimeout(function() {
                        $(progress[pcounter]).addClass("hide");
                }, 2000);
                this.tryCount++;
                if(this.tryCount >= this.retryLimit) return;
                $.ajax(this);
    },
        success: (data) => {
                $(posted).removeClass("hide");
                setTimeout(function() {
                        $(posted).addClass("fade-hidden");
                        $(progress[pcounter]).addClass("fade-hidden");
                        $(progressLabel[pcounter]).addClass("fade-hidden");
                        progress[pcounter].value = 100;
                        setTimeout(function() {
                                $(posted).addClass("hide");
                                $(posted).removeClass("fade-hidden");
                                $(progress[pcounter]).addClass("hide");
                                $(progressLabel[pcounter]).addClass("hide");
                        }, 2000);
                }, 2000);
        },
    });
}
$(submitBtn).on("click", function(e){
        e.preventDefault();
        form = document.getElementById("post-form");
        imgPreview.innerHTML = "";
        var uploaded = false;
        for(image of chooseFileFiles) {
                if(image) {
                        var fd = new FormData(form);
                        fd.set("confirmation_id", String(Math.floor(Math.random() * 100000000)));
                        fd.set("image", image);
                        fd.delete("file");
                uploaded = true;
$("#progressBars").append(
    '<div style="margin-bottom:0.5em;"><progress id="progress' + current + '" value="0" max="100"></progress> ' +
    '<span id="progress-label-' + current + '">0%</span></div>'
);
            setTimeout(function(fd, current) { uploadFile(fd, current) }, current * {{ upload_interval }}, fd, current);
            current++;
                }
        }
        for(file of chooseVideoFile.files) {
                if(file) {
                        var fd = new FormData(form);
                        fd.set("confirmation_id", String(Math.floor(Math.random() * 100000000)));
                        fd.set("file", file);
                        fd.delete("image");
                uploaded = true;
$("#progressBars").append(
    '<div style="margin-bottom:0.5em;"><progress id="progress' + current + '" value="0" max="100"></progress> ' +
    '<span id="progress-label-' + current + '">0%</span></div>'
);
            setTimeout(function(fd, current) { uploadFile(fd, current) }, current * {{ upload_interval }}, fd, current);
            current++;
                }
        }
        if(!uploaded) {
                var fd = new FormData(form);
                fd.set("confirmation_id", String(Math.floor(Math.random() * 100000000)));
                uploaded = true;
$("#progressBars").append(
    '<div style="margin-bottom:0.5em;"><progress id="progress' + current + '" value="0" max="100"></progress> ' +
    '<span id="progress-label-' + current + '">0%</span></div>'
);
        setTimeout(function(fd, current) { uploadFile(fd, current) }, current * {{ upload_interval }}, fd, current);
        current++;
        }
        form.reset();
});
chooseFile.addEventListener("change", function () {
  getImgData();
});
function removeImage(imageId) {
  var image = document.getElementById(imageId);
  var index = parseInt(imageId.substring(5));
  chooseFileFiles[index] = null;
  image.remove();
}
function getImgData() {
  imgPreview.innerHTML = "";
  chooseFileFiles = Array.from(chooseFile.files);
  const files = chooseFile.files[0];
  if (files) {
    for(var x = 0; x < chooseFile.files.length; x++) {
      var fileReader = new FileReader();
      fileReader.index = x;
      fileReader.readAsDataURL(chooseFile.files[x]);
      fileReader.addEventListener("load", function(evt) {
        imgPreview.insertAdjacentHTML("beforeend", '<div class="img-container" style="display: inline; float: left; position: relative; left: 2%; margin-left: 1%; margin-right: 1%; margin-top: 2%; width: 31%;" id="image' + evt.target.index + '"><img width="100%" src="' + this.result + '"/><div class="img-clear" onclick="removeImage(\'image' + evt.target.index + '\');"><i class="bi bi-x-circle-fill" style="font-size: 35px"></i></div></div>');
        {% if nudity_censor %}
        setTimeout(function() {
            detectImage("image" + evt.target.index, chooseFile, x);
        }, 3000 * x);
        {% endif %}
      });
    }
  }
}
{% if nudity_censor %}
const cvcanvas = document.getElementById('cvcanvas');
const cvctx = cvcanvas.getContext('2d');
var nsfwjsmodel;
nsfwjs.load('/static/js/models/mobilenet_v2/').then(function(model) {
    nsfwjsmodel = model;
});
function detectImage(image_id, chooseFile, x) {
    var image = document.getElementById(image_id);
    cvcanvas.width = Math.trunc(image.naturalWidth * {{ nudity_censor_scale }});
    cvcanvas.height = Math.trunc(image.naturalHeight * {{ nudity_censor_scale }});
    cvctx.clearRect(0, 0, cvcanvas.width, cvcanvas.height);
    cvctx.drawImage(image, 0, 0, Math.trunc(image.naturalWidth * {{ nudity_censor_scale }}), Math.trunc(image.naturalHeight * {{ nudity_censor_scale }}));
    console.log('detected image ' + new String(x));
    nsfwjsmodel.classify(cvcanvas, 1).then(function (predictions) {
        console.log(predictions[0]);
        if(predictions[0].className == 'Porn' && predictions[0].probability > 0.95) {
            console.log('Nude');
            removeImage(image_id);
        } else {
            console.log('not nude');
        }
        if(x >= chooseFile.files.length - 1) {
            submitBtn.disabled = false;
        }
    });
}
{% endif %}
$(document).ready(function() {
    {% if not request.GET.raw %}
    function onSummernoteInit() {
        $('[data-toggle="dropdown"]').each(function(index, el) {
            el.dataset.bsToggle = "dropdown";
        });
        {% if not darkmode %}
        const summernoteElement = document.getElementById('id_content');
        if (summernoteElement) {
            function getAllTextNodes(element) {
              const textNodes = [];

              function traverse(node) {
                // Check if the node is a text node
                if (node.nodeType === Node.TEXT_NODE) {
                  // Add the trimmed text content to the array
                  const textContent = node.nodeValue.trim();
                  if (textContent.length > 0) { // Only add non-empty text
                    textNodes.push(node);
                  }
                } else {
                  // Recursively traverse child nodes
                  for (const childNode of node.childNodes) {
                    traverse(childNode);
                  }
                }
              }

              traverse(element);
              return textNodes;
            }
          const iElements = getAllTextNodes(summernoteElement);
          for (let i = 0; i < iElements.length; i++) {
            const currentIElement = iElements[i];
            currentIElement.style = "color: black !important;";
            console.log(currentIElement);
          }
        } else {
          console.log("Element with ID 'summernote' not found.");
        }
        {% else %}
        function getAllChildElements(parentElement) {
          const children = [];
          function traverse(node) {
            for (let i = 0; i < node.children.length; i++) {
              const childElement = node.children[i];
              if(childElement.tagName != 'BUTTON' && childElement.tagName != 'OPTION' && childElement.tagName != 'DIV' && childElement.tagName != 'I' && childElement.tagName != 'INPUT' && childElement.tagName != 'TEXTAREA' && childElement.tagName != 'LABEL' && childElement.tagName != 'SPAN' && childElement.tagName != 'A' && !childElement.classList.contains('note-btn-group') && !childElement.classList.contains('form-group') && !childElement.classList.contains('form-check') && !childElement.classList.contains('select') && !childElement.classList.contains('form-check-label')) {
                children.push(childElement);
              } else if (((childElement.tagName == 'LABEL' && (childElement.classList.contains('note-form-label') || childElement.classList.contains('form-check-label'))) || (childElement.tagName == 'INPUT' && childElement.classList.contains('note-image-input'))) && !childElement.getAttribute('FOR').startsWith('id_')) {
                children.push(childElement);
              } else if(childElement.tagName != 'TEXTAREA' && childElement.tagName != 'INPUT') {
                traverse(childElement);
              }
            }
          }
          traverse(parentElement); // Start the traversal from the initial parent
          return children;
        }
        const bodyChildren = getAllChildElements(document.getElementById('summernote'));
        for (let i = 0; i < bodyChildren.length; i++) {
            const currentIElement = bodyChildren[i];
            currentIElement.style = "color: black !important;";
            console.log(currentIElement);
        }
        {% endif %}
    }
    $(document).on('summernote.init', '#id_content', onSummernoteInit);
    $('#id_content').summernote({
        fontNames: ['Arial', 'Arial Black', 'Comic Sans MS', 'Courier New'{% if request.user.vendor_profile.video_intro_font %}, 'Vendor Specified ({{ request.user.profile.name }})'{% endif %}],
        {% if request.user.vendor_profile.video_intro_font %}        fontNamesIgnoreCheck: ['Vendor Specified ({{ request.user.profile.name }})'],{% endif %}
        toolbar: [
            ['style', ['style']],
            ['font', ['bold', 'italic', 'underline', 'clear']],
            ['font', ['fontname', 'fontsize', 'color']],
            ['para', ['ul', 'ol', 'paragraph']],
            ['height', ['height']],
            ['table', ['table']],
            ['insert', ['link', 'picture', 'video', 'hr']],
            ['view', ['fullscreen', 'codeview', 'help']],
            ['misc', ['undo', 'redo']]
        ],
    });    
    {% endif %}
});
{% endblock %}
