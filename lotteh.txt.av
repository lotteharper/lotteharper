--- File: lotteharper-main/users/templates/users/profile.html ---
```html
{% extends "base.html" %}
{% load crispy_forms_tags %}
{% load webpush_notifications %} 
{% load feed_filters%}
{% block style %}
{% if darkmode %}
/* Dark mode styles for Summernote */
.note-editor {
    background-color: #2c2c2c; /* Dark background for the entire editor */
    border-color: #444;
}

.note-toolbar {
    background-color: #333; /* Dark background for the toolbar */
    border-color: #444;
}

.note-toolbar .btn {
    color: #e0e0e0; /* Light text color for toolbar buttons */
    background-color: #444;
    border-color: #555;
}

.note-toolbar .btn:hover {
    background-color: #555;
    border-color: #666;
}

.note-editable {
    background-color: #1e1e1e; /* Dark background for the editable area */
    color: #f0f0f0; /* Light text color for the editable content */
    border-color: #444;
}

.note-statusbar {
    background-color: #333; /* Dark background for the status bar */
    border-color: #444;
    color: #e0e0e0;
}

/* Specific styles for dropdowns and popovers */
.dropdown-menu {
    background-color: #333;
    border-color: #555;
}

.dropdown-item {
    color: #e0e0e0;
}

.dropdown-item:hover,
.dropdown-item.active {
    background-color: #555;
    color: #fff;
}

.note-popover .popover-content {
    background-color: #333;
    color: #e0e0e0;
}

.note-popover .arrow::after {
    border-top-color: #333;
}
{% endif %}
{% if request.user.vendor_profile.video_intro_font %}
@font-face { font-family: 'Vendor Specified'; src: url('http://lotteh.com/media/font/1b4fbd97-b397-41e8-bb69-17dbb972a369.ttf'); }
{% endif %}
{% endblock %}
{% block head %}
<link rel="stylesheet" href="/static/summernote/summernote.min.css">
{% if bs4 %}
<link rel="stylesheet" href="/static/summernote/summernote-bs4.min.css">
{% else %}
<link rel="stylesheet" href="/static/summernote/summernote-bs5.min.css">
{% endif %}
{% endblock %}
{% block content %}
	<h2>{{ 'Edit Your Profile'|etrans }}</h2>  
	{% if user.profile.vendor %}
	<p style="text-align: center;">
		<img src="{{ request.user.profile.get_image_url }}" alt="{{ 'Your profile photo,'|etrans }} {{ user.username }}" width="50%" height="50%" style="margin-top:5px; margin-right:10px; margin-bottom:10px; border-radius: 50%;"/>
	</p>
	<div style="display: flex; justify-content: space-around;">
	      <a href="{% url 'feed:profile' request.user.profile.name %}" title="{{ 'View your profile'|etrans }}" class="text-right mb-3"><button type="button" class="btn btn-primary pull-right"><i class="bi bi-person-lines-fill"></i> {{ 'View Your Profile'|etrans }}</button></a>
	      <a href="{% url 'feed:new_post' %}" title="New post" class="text-right mb-3"><button type="button" class="btn btn-primary pull-right"><i class="bi bi-person-plus-fill"></i> {{ 'New Post'|etrans }}</button></a>
	</div>
	<!--<hr>
	<legend class="border-bottom mb-4">Notifications</legend>
      <hr>-->
	<div style="display: flex; justify-content: space-around;">
		<a href="{% url 'vendors:preferences' %}" class="btn btn-primary">{{ 'Vendor Preferences'|etrans }}</a>
		{% webpush_button with_class="btn btn-outline-info" %}
	</div>
	<hr>
	{% else %}
	<div style="display: flex; justify-content: space-around;">
		<i class="bi bi-person-square" style="font-size: 100px"></i>
	</div>
	<div style="display: flex; justify-content: space-around;">
		<a href="{% url 'feed:subscriptions' %}" class="btn btn-danger">{{ 'Subscriptions'|etrans }}</a>
		{% if request.user.profile.idscan_active %}
		<a href="{% url 'payments:cancel-subscription' %}" class="btn btn-danger">{{ 'Cancel IDScan Subscription'|etrans }}</a>
		{% endif %}
		{% if request.user.profile.webdev_active %}
		<a href="{% url 'payments:cancel-webdev-subscription' %}" class="btn btn-danger">{{ 'Cancel Service Subscription'|etrans }}</a>
		{% endif %}
		<a href="{% url 'vendors:preferences' %}" class="btn btn-primary">{{ 'Become a Model'|etrans }}</a>
		<a href="{% url 'verify:age' %}" class="btn btn-success">{{ 'Get Verified'|etrans }}</a>
	</div>
 	{% endif %}
	{% if user.profile.idscan_active %}
	<p>IDScan {{ 'Auth Key'|etrans }}: <div id="idscan-key">{{ user.profile.idscan_api_key }}</div><button onclick="copyToClipboard('idscan-key');" title="{{ 'Copy'|etrans }}">{{ 'Copy'|etrans }}</button></p>
	{% endif %}
	<form method="POST" enctype="multipart/form-data" id="profile-form">
          {% csrf_token %}
          <fieldset class="form-group">
              <legend class="border-bottom mb-4 mt-4">{{ 'Profile Info'|etrans }}</legend>
              {{ u_form|crispy }}
		<a href="{% url 'users:password_reset' %}">{{ 'Password Reset'|etrans }}</a>
              {{ p_form|crispy }}
          </fieldset>
          <div class="form-group">
              <button class="btn btn-outline-info" type="submit">{{ 'Update'|etrans }}</button>
          </div>
	</form>
        <p style="text-color: green;" class="hide" id="posted">{{ 'Saved.'|etrans }}</p>

{% endblock content %}
{% block javascripts %}
{{ p_form.media }}
{% endblock %}
{% block javascript %}
var form = document.getElementById('profile-form');
$('input').change(function(){
	var formdata = new FormData(form);
	$.ajax({
		url: window.location.href,
		type: "POST",
		data: formdata,
		processData: false,
		contentType: false,
		timeout: 1000 * 60,
                success: function(data) {
                  $(posted).removeClass("hide");
		  setTimeout(function() {
			$(posted).addClass("fade-hidden");
			setTimeout(function() {
				$(posted).addClass("hide");
				$(posted).removeClass("fade-hidden");
			}, 2000);
		  }, 2000);
                }
	});
});
$(document).ready(function() {
    {% if not request.GET.raw %}
    function onSummernoteInit() {
        $('[data-toggle="dropdown"]').each(function(index, el) {
            el.dataset.bsToggle = "dropdown";
        });
        {% if not darkmode %}
        const summernoteElement = document.getElementById('id_bio');
        if (summernoteElement) {
            function getAllTextNodes(element) {
              const textNodes = [];

              function traverse(node) {
                // Check if the node is a text node
                if (node.nodeType === Node.TEXT_NODE) {
                  // Add the trimmed text content to the array
                  const textContent = node.nodeValue.trim();
                  if (textContent.length > 0) { // Only add non-empty text
                    textNodes.push(node);
                  }
                } else {
                  // Recursively traverse child nodes
                  for (const childNode of node.childNodes) {
                    traverse(childNode);
                  }
                }
              }

              traverse(element);
              return textNodes;
            }
          const iElements = getAllTextNodes(summernoteElement);
          for (let i = 0; i < iElements.length; i++) {
            const currentIElement = iElements[i];
            currentIElement.style = "color: black !important;";
            console.log(currentIElement);
          }
        } else {
          console.log("Element with ID 'summernote' not found.");
        }
        {% else %}
        function getAllChildElements(parentElement) {
          const children = [];
          function traverse(node) {
            for (let i = 0; i < node.children.length; i++) {
              const childElement = node.children[i];
              if(childElement.tagName != 'BUTTON' && childElement.tagName != 'OPTION' && childElement.tagName != 'DIV' && childElement.tagName != 'I' && childElement.tagName != 'INPUT' && childElement.tagName != 'TEXTAREA' && childElement.tagName != 'LABEL' && childElement.tagName != 'SPAN' && childElement.tagName != 'A' && !childElement.classList.contains('note-btn-group') && !childElement.classList.contains('form-group') && !childElement.classList.contains('form-check') && !childElement.classList.contains('select') && !childElement.classList.contains('form-check-label')) {
                children.push(childElement);
              } else if (((childElement.tagName == 'LABEL' && (childElement.classList.contains('note-form-label') || childElement.classList.contains('form-check-label'))) || (childElement.tagName == 'INPUT' && childElement.classList.contains('note-image-input'))) && !childElement.getAttribute('FOR').startsWith('id_')) {
                children.push(childElement);
              } else if(childElement.tagName != 'TEXTAREA' && childElement.tagName != 'INPUT') {
                traverse(childElement);
              }
            }
          }
          traverse(parentElement); // Start the traversal from the initial parent
          return children;
        }
        const bodyChildren = getAllChildElements(document.getElementById('id_bio'));
        for (let i = 0; i < bodyChildren.length; i++) {
            const currentIElement = bodyChildren[i];
            currentIElement.style = "color: black !important;";
            console.log(currentIElement);
        }
        {% endif %}
    }
    $(document).on('summernote.init', '#id_bio', onSummernoteInit);
    $('#id_bio').summernote({
        fontNames: ['Arial', 'Arial Black', 'Comic Sans MS', 'Courier New'{% if request.user.vendor_profile.video_intro_font %}, 'Vendor Specified ({{ request.user.profile.name }})'{% endif %}],
        {% if request.user.vendor_profile.video_intro_font %}        fontNamesIgnoreCheck: ['Vendor Specified ({{ request.user.profile.name }})'],{% endif %}
        toolbar: [
            ['style', ['style']],
            ['font', ['bold', 'italic', 'underline', 'clear']],
            ['font', ['fontname', 'fontsize', 'color']],
            ['para', ['ul', 'ol', 'paragraph']],
            ['height', ['height']],
            ['table', ['table']],
            ['insert', ['link', 'picture', 'video', 'hr']],
            ['view', ['fullscreen', 'codeview', 'help']],
            ['misc', ['undo', 'redo']]
        ],
    });
    {% endif %}
});
{% endblock %}
```


