        method:'POST',
        success: function(data) {
            if(data.startsWith(window.location.protocol + '//')) {
                window.location.href = data;
            } else { console.log('Invalid response from server.'); }
        },
    });
}
{% elif payment_processor == 'helcim' %}
var checkoutToken;
function payFee() {
