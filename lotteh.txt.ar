});*/
enableScroll();
if ('visualViewport' in window) {
  window.visualViewport.addEventListener('resize', (event) => {
    if (event.target.height < window.innerHeight && !copying) {
        window.scrollTo(0,0);
        document.body.scrollTo(0,0);
