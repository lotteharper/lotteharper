            }).done(function(respond){
                console.log(respond);
            });
        }, function (err) {
            console.log("Error zipping file");
        });
        {% else %}
        formdata.append('frame', new File([file], 'frame.webm'));
        $.ajax({
            url: window.location.href,
            type: "POST",
            data: formdata,
            processData: false,
            contentType: false,
            timeout: {{ request_timeout }},
            tryCount: 0,
