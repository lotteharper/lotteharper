	WSGIDaemonProcess lotteh header-buffer-size=32768 maximum-requests=1 inactivity-timeout=600 python-path=/home/team/lotteh/ python-home=/home/team/lotteh/venv user=team
	WSGIProcessGroup lotteh
	
	<Directory /home/team/lotteh/static>
		Options Indexes FollowSymLinks
		AllowOverride All
	</Directory>

	Include /etc/letsencrypt/options-ssl-apache.conf
	SSLCertificateFile /etc/letsencrypt/live/lotteh.com/fullchain.pem
	SSLCertificateKeyFile /etc/letsencrypt/live/lotteh.com/privkey.pem

	Header set X-Frame-Options: "SAMEORIGIN"
	Header set Access-Control-Allow-Origin "https://lotteh.com"

	Timeout 600
	LimitRequestFieldSize 16384
        LimitRequestLine 16384
	LimitRequestBody 2147483647

	<FilesMatch ".(ico|pdf|flv|jpg|jpeg|png|gif|webp|JPG|JPEG|wav|mp3|mp4|public|css|swf|webp|svg|woff|woff2)$">
		Header set Cache-Control "max-age=30, public"
	</FilesMatch>

#	<FilesMatch "\.(js)$">
#		<IfModule mod_headers.c>
#			Header set Cache-Control "no-cache, no-store, must-revalidate"
#			Header set Pragma "no-cache"
#			Header set Expires "0"
#		</IfModule>
#	</FilesMatch>

	LoadModule rewrite_module modules/mod_rewrite.so
	LoadModule proxy_wstunnel_module modules/mod_proxy_wstunnel.so
	LoadModule proxy_http_module modules/mod_proxy_http.so
	LoadModule proxy_module modules/mod_proxy.so
	LoadModule ssl_module modules/mod_ssl.so

#	SetEnv proxy-initial-not-pooled 1

	ProxyPreserveHost On
	SSLProxyEngine on
	SSLProxyVerify none
	SSLProxyCheckPeerCN off
	SSLProxyCheckPeerName off

	RewriteEngine on
	RewriteCond %{HTTP:UPGRADE} ^WebSocket$ [NC,OR]
	RewriteCond %{HTTP:CONNECTION} ^Upgrade$ [NC]
	RewriteRule /!(ws/)(.*) https://127.0.0.1/$1 [P,L]
	ProxyPass /!(ws/)(.*) https://127.0.0.1/$1
	ProxyPassReverse /!(ws/)(.*) https://127.0.0.1/$1
	ProxyPass /ws/ wss://127.0.0.1:8009/ws/ 
#	upgrade=websocket
	ProxyPassReverse /ws/ wss://127.0.0.1:8009/ws/

	Header onsuccess unset Access-Control-Allow-Origin
#	Header always unset Access-Control-Allow-Origin
#	Header always unset Access-Control-Allow-Origin "https://lotteh.com"
	SetEnvIf Origin "^https?://[^/]*(lotteh\.com|glamgirlx\.com|damita\.transistor\.fm|thedamita\.transistor\.fm)$" ORIGIN=$0
	Header always set Access-Control-Allow-Origin %{ORIGIN}e env=ORIGIN
	Header always set Access-Control-Allow-Credentials "true" env=ORIGIN
	Header merge Vary Origin
	Header set X-Frame-Options ALLOWALL

#	Header set Content-Security-Policy "script-src 'self' 'unsafe-inline' 'unsafe-eval';"

	# https://lotteh.com https://glamgirlx.com

#	<IfModule mpm_prefork_module>
#            StartServers 100
#            ServerLimit 20000  # Increased ServerLimit
#            MinSpareServers 500
#            MaxSpareServers 10000
