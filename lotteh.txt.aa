```html
{% load app_filters %}
{% load feed_filters %}
<!DOCTYPE html>
<html lang="{{ lang }}">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="{{ description }}" />
        <meta name="author" content="{{ author_name }}" />
        <title>{{ title|etrans }} - {{ the_site_name }}</title>
        <!-- Favicon-->
        <link rel="icon" type="image/x-icon" href="/media/static/favicon.ico" />
        <!-- Custom Google font-->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@100;200;300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
        <!-- Bootstrap icons-->
        <link rel="stylesheet" href="/static/fonts/bootstrap-icons.min.css">
        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="/static/landing/styles.css" rel="stylesheet" />
	<script type="text/javascript" src="/static/qrcode.min.js"></script>
	<script type="text/javascript" src="/static/jquery-3.7.1.min.js"></script>
	<style>
    iframe { 
      width: 100%;
      aspect-ratio: 16 / 9;
    }
	.hide {
	        opacity: 0;
	        display: none;
	        visibility: hidden;
	        pointer-events: none;
	}
	@keyframes fadeIn {
	  0% { opacity: 0; }
	  100% { opacity: 1; }
	}
	@keyframes fadeOut {
	  0% { opacity: 1; }
	  100% { opacity: 0; }
	}
	.fade-in {
	        animation: fadeIn 2s;
	        opacity: 1;
	}
	.fade-hidden {
	        animation: fadeOut 2s;
	        opacity: 0;
	}
	.fade-in-fast {
	        animation: fadeIn 0.5s;
	        opacity: 1;
	}
	.fade-hidden-fast {
	        animation: fadeOut 0.5s;
	       	opacity: 0;
	}
	.clockContainer {
	    position: relative;
	    display: inline-block;
	    margin: auto;
	    height: 40px;
	    width: 40px;
	    background-color: #ffcccb;
	    border-radius: 50%;
	    background-size: 100%;
	    border: 1px solid black;
	}
	.hour,
	.minute,
	.second {
	    position: absolute;
	    background: black;
	    border-radius: 10px;
	    transform-origin: bottom;                                                                                                      }
	.hour {
	    width: 1.8%;
	    height: 25%;
	    top: 25%;
	    left: 48.85%;
	    opacity: 0.8;                                                                                                                  }
	.minute {
	    width: 1.6%;
	    height: 30%;
	    top: 19%;
	    left: 48.9%;
	    opacity: 0.8;
	}
	.second {
	    width: 1%;
	    height: 40%;
	    top: 9%;
	    left: 49.25%;
	    opacity: 0.8;
	}
      .btn-xlarge {
          padding: 18px 18px;
          font-size: 30px;
          line-height: normal;
          -webkit-border-radius: 8px;
             -moz-border-radius: 8px;
                  border-radius: 8px;
          }
	</style>
	{% include 'google_adsense_head_code.html' %}
    </head>
    <body class="d-flex flex-column h-100">
	{% include 'users/register_modal.html' %}
        {% load cookielaw_tags %}
        {% if cookielaw.notset %}{% rejectable_cookielaw_banner %}{% endif %}
        <main class="flex-shrink-0">
            <!-- Navigation-->
            <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
                <div class="container px-5">
                    <a class="navbar-brand" href="{% url 'app:app' %}?k={% get_key %}" title="{{ 'The Homepage'|etrans }}" rel="nofollow">
	               <img src="{{ icon_url }}" alt="{{ the_site_name }}'s {{ 'Logo'|etrans }}" width="30" height="30" style="border-radius: 50%;">
	               <span class="fw-bolder text-primary">{{ the_site_name }}</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 small fw-bolder">
                            <li class="nav-item"><a class="nav-link" href="{% url 'app:app' %}?k={% get_key %}" title="{{ 'Visit the home page'|etrans }}">{{ 'Home'|etrans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ resume_url }}" title="{{ 'Read my resume'|etrans }}">{{ 'Resume'|etrans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ github_url }}" title="{{ 'Visit my GitHub'|etrans }}">{{ 'Projects'|etrans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{% url 'app:app' %}" title="{{ 'See the photography'|etrans }}">{{ 'Photos'|etrans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="tel:{{ main_phone|phone_number }}" title="{{ 'Contact me'|etrans }}">{{ 'Contact'|etrans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{% url 'users:login' %}" title="{{ 'Log in to the app'|etrans }}">{{ 'Login'|etrans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{% url 'users:register' %}" title="{{ 'Sign up now'|etrans }}">{{ 'Signup'|etrans }}</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
            <!-- Header-->
            <header class="py-5">
                <div class="container px-5 pb-5">
                    <div class="row gx-5 align-items-center">
                        <div class="col-xxl-5">
                            <!-- Header text content-->
                            <div class="text-center text-xxl-start">
                                <div class="badge bg-gradient-primary-to-secondary text-white mb-4"><div class="text-uppercase">{{ 'Design'|etrans }} &middot; {{ 'Development'|etrans }} &middot; {{ 'Marketing'|etrans }} &middot; {{ 'Compliance'|etrans }}</div></div>
                                <div class="fs-3 fw-light text-muted">{{ 'I can help your business to'|etrans }}</div>
                                <h1 class="display-3 fw-bolder mb-5"><span class="text-gradient d-inline">{{ 'Get online and grow fast'|etrans }}</span></h1>
                                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center justify-content-xxl-start mb-3">
                                    <a class="btn btn-primary btn-lg px-5 py-3 me-sm-3 fs-6 fw-bolder" href="{{ resume_url }}" title="{{ 'My updated resume'|etrans }}">{{ 'Resume'|etrans }}</a>
                                    <a class="btn btn-outline-dark btn-lg px-5 py-3 fs-6 fw-bolder" href="{{ github_url }}" title="{{ 'My GitHub projects'|etrans }}">{{ 'Projects'|etrans }}</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-xxl-7">
                            <!-- Header profile picture-->
                            <div class="d-flex justify-content-center mt-5 mt-xxl-0">
                                <div class="profile bg-gradient-primary-to-secondary">
