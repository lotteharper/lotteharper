        print('Auth 2? {}'.format(str(auth2)))
        if not token:
            print('Token invalid for shell')
            return
        if not (auth and auth2): return
        await self.accept()
        self.connected = True
        user = await get_user(self.scope['user'].id)
        self.send(text_data='connect')

