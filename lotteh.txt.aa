    recordings = None
    private_recordings = None
#    from django.db.models import Count
    recordings = VideoRecording.objects.filter(duration__gte=120, user__profile__name=username, processed=True, safe=not minor_document_scanned(request.user), youtube_processed=True).exclude(youtube_id='').order_by('-last_frame')
    p = Paginator(recordings, 20)
    if page > p.num_pages or page < 1 or len(recordings) == 0:
        messages.warning(request, "The page you requested, " + str(page) + ", does not exist. You have been redirected to the first page.")
        page = 1
    return render(request, 'recordings/recordings.html', {
