@login_required
@user_passes_test(is_vendor)
@user_passes_test(minor_identity_verified, login_url='/verify/', redirect_field_name='next')
def recent(request):
    from live.models import VideoRecording
    from django.utils import timezone
    import datetime
    from_date = timezone.now() - datetime.timedelta(hours=24)
    uploaded = VideoRecording.objects.filter(user=request.user, processed=True, uploaded=True, last_frame__gte=from_date).exclude(youtube_id='').order_by('-last_frame')
    proc = VideoRecording.objects.filter(user=request.user, processing=True, processed=False, last_frame__gte=from_date).order_by('-last_frame')
    nonproc = VideoRecording.objects.filter(user=request.user, processed=False, processing=False, last_frame__gte=from_date).order_by('-last_frame')
    from django.shortcuts import render
    return render(request, 'recordings/status.html', {
        'title': 'Review your recordings',
        'uploaded_vids': uploaded,
        'processing_vids': proc,
        'nonprocessing_vids': nonproc,
    })

