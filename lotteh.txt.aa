{% csrf_token %}
{{ form|crispy }}
<button class="btn btn-outline-primary" type="submit" title="{{ 'Submit form'|etrans }}">{{ 'Submit form'|etrans }}</button>
</form>
{% else %}
<div style="display: flex; justify-content: space-around;"><img src="{{ links_user.profile.get_image_url }}" style="border-radius: 50%; width: 250px;" alt="{{ links_user.profile.id|transbio|striptags }}"></div>
