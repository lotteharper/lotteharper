{% load feed_filters %}
<div class="row">
    <div class="article-metadata">
      <a class="mr-2" href="{% url 'feed:profile' username=profile.name %}" title="See @{{ profile.name }}'s profile">@{{ profile.name }}</a>
      <small class="text-muted">{{ profile.last_seen|date:"F d, Y" }} {{ profile.last_seen|time:"H:i" }}</small>
      <small class="text-muted"><i class="bi bi-translate"></i> {{ profile.bio|detectlanguage }}</small>
    </div>
    <p class="article-content"><img src="{% if profile.user in request.user.profile.subscriptions.all %}{{ profile.get_image_url }}{% else %}{{ profile.get_face_blur_url }}{% endif %}" alt="@{{ profile.user.username }}'s profile photo" width="120" height="120" align="left" style="margin-top:5px; margin-right:10px; margin-bottom:10px; border-radius: 50%;"/>{% autoescape off %}{{ profile.id|transbio|addhttpstodomains|embedlinks|tagusers }}{% endautoescape %}</p>
   <div style="display: flex; justify-content: space-around;">
    <a href="{% url 'feed:profile' profile.name %}" title="See @{{ profile.name }}'s profile" class="btn btn-outline-success">{{ 'See Profile'|etrans }}</a>
   </div>
</div>
<hr>
```


