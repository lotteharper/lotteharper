            elif not url.lower().startswith('https://clemn.com') and url.lower().startswith('https://'):
                try:
                    response = requests.head(url, timeout=10)
                    if response.status_code == 200:
                        dic[url] = '<a href=\"' + url + '\" title=\"' + 'Visit this link' + plus + '\"' + ex + '>' + url[8:] + '</a>'
