        'profile': profile,
        'following': following,
        'full': True,
        'hiderrm': True if request.GET.get('handtrack', False) else False,
        'tip_options': choices,
        'feeds': get_post_feeds(),
    })
    if request.user.is_authenticated: patch_cache_control(resp, private=True)
    else: patch_cache_control(resp, public=True)
    return resp

