{% block javascript %}
var download_inc = 1;
const download = function (canvas) {
    const link = document.createElement('a');
    link.download = '{{ the_site_name }} - Photo ' + download_inc + '.png';
    download_inc++;
    link.href = canvas.toDataURL()
