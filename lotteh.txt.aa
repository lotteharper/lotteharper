<link rel="stylesheet" href="/static/clock/clock.css">
<style>
{% if darkmode %}
p, h1, h2, h3, h4, h5, legend, i, nav-link, navbar-brand, div, small, b {
	color: white;
	text-color: white;
}
hr {
	border-color: white;
}
a {
	color: #94c7ff;
}
.text-muted {
	color: white !important;
	text-color: white !important;
}
