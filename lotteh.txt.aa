--- File: lotteharper-main/config/etc_conf.d_celery ---
```
# Name of nodes to start
# here we have a single node
CELERYD_NODES="w1 w2"
# or we could have three nodes:
#CELERYD_NODES="w1 w2 w3"

# Absolute or relative path to the 'celery' command:
CELERY_BIN="/home/team/lotteh/venv"
#CELERY_BIN="/virtualenvs/def/bin/celery"

# App instance to use
# comment out this line if you don't use an app
CELERY_APP="lotteh"
# or fully qualified:
#CELERY_APP="proj.tasks:app"

# How to call manage.py
CELERYD_MULTI="multi"

# Extra command-line arguments to the worker
CELERYD_OPTS="--time-limit=300000 --concurrency=8"

# - %n will be replaced with the first part of the nodename.
# - %I will be replaced with the current child process index
#   and is important when using the prefork pool to avoid race conditions.
CELERYD_PID_FILE="/var/run/celery/%n.pid"
CELERYD_LOG_FILE="/var/log/celery/%n%I.log"
CELERYD_LOG_LEVEL="INFO"

# you may wish to add these options for Celery Beat
CELERYBEAT_PID_FILE="/var/run/celery/beat.pid"
CELERYBEAT_LOG_FILE="/var/log/celery/beat.log"
```


--- File: lotteharper-main/config/etc_default_celery ---
```
# The names of the workers. This example create two workers
#CELERYD_NODES="worker1 worker2"

CELERYD_NODES="worker1 worker2"

# The name of the Celery App, should be the same as the python file
# where the Celery tasks are defined
CELERY_APP="lotteh"

CELERYD_MULTI="multi"

# Log and PID directories
CELERYD_LOG_FILE="/home/team/lotteh/celery/log/%n%I.log"
CELERYD_PID_FILE="/home/team/lotteh/celery/pid/%n.pid"

CELERYBEAT_PID_FILE="/home/team/lotteh/celery/pid/beat.pid"
CELERYBEAT_LOG_FILE="/home/team/lotteh/celery/log/beat.log"

# Log level
CELERYD_LOG_LEVEL=INFO

# Path to celery binary, that is in your virtual environment
CELERY_BIN=/home/team/lotteh/venv/bin/celery

CELERYD_USER="team"
CELERYD_GROUP="users"
```


