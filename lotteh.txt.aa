            chunk = "https://" + chunk
        urls = extractor.find_urls(chunk);
        dic = {}
        for url in urls:
            plus = ' (it\'s on Clemn)'
            ex = ''
            if not url[8:17].lower() == 'clemn.com':
                plus = ' (it will take you outside of Clemn)'
                ex = ' id=\"external-link\"'
