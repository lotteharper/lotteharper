	}
  }, 1000);
};
function end() {
	endTime = new Date();
	var timeDiff = endTime - startTime; //in ms
	// strip the ms
	timeDiff /= 1000;
	seconds = Math.floor(timeDiff);
	elapsed.innerHTML = formatTime(seconds) + " elapsed";
}
