			read = true;
		}, 1500);
	}, 1000);
  } else {
	document.getElementById("current-text").innerHTML = "";
	$('.cmodal').addClass('fade-hidden');
	$(document.getElementById("clemn-navbar")).autoHidingNavbar().show();
  }
  e.preventDefault();
});
$(document).ready(function() {
	setTimeout(function() {
		read = true;
	}, 3000);
});
