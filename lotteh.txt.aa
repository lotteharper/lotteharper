          display: block;
          margin: 0 auto;
        }
        .call-button {
          padding: 1rem 2rem;
          border: none;
          border-radius: 3px;
          cursor: pointer;
          color: white;
          background-color: black;
          box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.3);
        }
        #video-container {
          width: 100%;
          min-width: 300px;
          position: relative;
        }
        #videos {
          position: relative;
        }
        video {
          background-color: black;
          border-radius: 3px;
          box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.3);
        }
        #local-video {
          position: absolute;
          width: 25vw;
          height: 25vw;
          bottom: -30px;
          right: 0px;
        }
