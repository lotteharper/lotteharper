</div>
{% endblocktrans %}
{% endif %}
<hr style="background-color: green;">
<div style="display: flex; justify-content: space-around;">
{% blocktrans en %}
<a href="{% url 'audio:recordings' %}?model={{ profile.name }}" class="btn btn-outline-danger" title="{{ 'Audio recordings' }}">{{ 'Audio' }}</a>
<a class="btn btn-outline-info" href="{% url 'recordings:recordings' profile.name %}" title="{{ 'See recordings recorded by' }} @{{ profile.name }}">{{ 'Watch Videos' }}</a>
<a class="btn btn-outline-success" href="{% url 'stream:watch' profile.name %}" title="{{ 'Watch the livestream recorded by' }} @{{ profile.name }}">{{ 'Watch Livestream' }}</a>
{% endblocktrans %}
</div>
{% blocktrans en %}
{% if user.is_authenticated %}
<hr style="background-color: blue;">
<div style="display: flex; justify-content: space-around;">
{% if request.GET.likes %}
<a class="btn btn-outline-success" href="{{ request.path }}" title="{{ 'All posts, not just what you like' }}">{{ 'All posts' }}</a>
{% else %}
<a class="btn btn-outline-success" href="{{ request.path }}?likes=true" title="{{ 'Posts you like' }}">{{ 'Likes' }}</a>
{% endif %}
{% if not request.path|startswith:"/feed/grid/" %}
<a class="btn btn-outline-secondary" href="{% url 'feed:profile-grid' profile.name %}" title="{{ 'Image grid' }}">{{ 'Grid' }}</a>
{% endif %}
{% if not request.path|startswith:"/feed/profile/" %}
<a class="btn btn-outline-primary" href="{% url 'feed:profile' profile.name %}" title="{{ 'Full profile' }}">{{ 'Profile' }}</a>
{% endif %}
{% if not request.GET.feed == 'news' %}
<a class="btn btn-outline-primary" href="{% url 'feed:profile' profile.name %}?feed=news" title="{{ 'News, books, games and more' }}">{{ 'News' }}</a>
{% endif %}
{% if profile.user.shared_link.count > 0 %}
<a class="btn btn-outline-dark" href="{% url 'links:links' profile.name %}" title="{{ 'See all my shared links' }}">{{ 'Links' }}</a>
{% endif %}
</div>
{% endif %}
{% endblocktrans %}
{% if show_wishlist %}
<hr style="background-color: pink;">
<div style="display: flex; justify-content: space-around;">
<a style="margin-right: 10px;" class="btn btn-outline-primary mr-1" title="{{ 'My Amazon (or other) wishlist'|etrans }}" href="{{ profile.wishlist }}"><i class="bi bi-bag-heart-fill"></i> {{ 'My Wishlist'|etrans }}</a>
<small class="padding-left: 10px;">{{ 'Ship to'|etrans }} <i class="bi bi-box2-heart-fill"></i> <i id="wishlist-address">{{ profile.user.vendor_profile.address }}</i> <button onclick="copyToClipboard('wishlist-address');" class="btn btn-sm btn-outline-info">{{ 'Copy'|etrans }}</button></small>
</div>
{% endif %}
<hr style="background-color: purple;" class="mb-5">
<p style="text-align:center;"><img class="center rounded mx-auto" style="width: 70%; max-width: 700px;" src="{% if profile.user in request.user.profile.subscriptions.all %}{{ profile.get_image_url }}{% else %}{{ profile.get_face_blur_url }}{% endif %}"></p>
<h1 style="text-align:center;">@{{ profile.name }}</h1>
<legend style="text-align: center;"><a href="tel:{{ main_phone|phone_number }}" title="{{ 'Call my phone,'|etrans }} {{ main_phone|phone_number }}"><i class="bi bi-telephone-outbound-fill"></i> {{ main_phone|phone_number }}</a>  <a href="tel:{{ main_phone|phone_number }}" title="{{ 'Call my phone,'|etrans }} {{ main_phone|phone_number }}"> {{ main_phone|character_phone_number }}</a></legend>
<legend>{% blocktrans en %}My pronouns are {{ profile.user.vendor_profile.pronouns|pronouns }}{% endblocktrans %}</legend>
{% with profile.user as theuser %}
{% include 'signature.html' %}
{% endwith %}
{% autoescape off %}
<p>{{ profile.id|transbio|addhttpstodomains|embedlinks|tagusers }}</p>
{% endautoescape %}
<p style="text-align:center;"><small class="text-muted">{{ 'Last Seen'|etrans }}: {{ profile.last_seen|date:"F d, Y" }} {{ profile.last_seen|time:"H:i" }}</small> - <small class="text-muted"> {{ 'Joined'|etrans }}: {{ profile.date_joined|date:"F d, Y" }} {{ profile.date_joined|time:"H:i" }}</small></p>
<div class="d-flex">{% with profile as content %}{% include 'clock.html' %}{% endwith %}</div>
{% if user.is_authenticated %}
{% if False %}
<div style="text-align:center;">
<h2>{{ 'Live Feed'|etrans }}</h2>
<iframe id="live" src="/stream/{{ profile.name }}/?hidenavbar=t{% if request.GET.lang %}&lang={{ request.GET.lang }}{% endif %}" width="100%" height="400px"></iframe>
</div>
{% endif %}
{% blocktrans en %}
{% if not request.GET.likes %}
<p>{{ 'Displaying all public posts.' }}</p>
{% else %}
<p>{{ 'Displaying posts you like.' }} <a href="{{ request.path }}" class="btn btn-sm btn-outline-success" title="{{ 'All posts by' }} @{{ profile.name }}">{{ 'See everything' }}</a></p>
{% endif %}
{% endblocktrans %}
<hr style="background-color: pink;" class="mb-5">
{% endif %}
{% endif %}
```


