def highlightsearchquery(text):
    otext = text
    q = get_current_request().GET['q'].split(' ')
    for query in q:
        t = re.split(query, text, flags=re.IGNORECASE)
        try:
            text = t[0] + '<mark>' + query + '</mark>' + t[1]
        except:
            try:
                query = query.lower()
                text = otext.split(query)
                text = text[0] + '<mark>' + query + '</mark>' + text[1]
            except:
                text = otext
    return text

