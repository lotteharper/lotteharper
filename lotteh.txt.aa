        lang = detect(value)
    except:
        lang = 'en'
    return lang

@register.filter(name='removelinks')
def removelinks(value):
    import re
    urls = re.findall("(?P<url>https?://[^\s]+)", value)
    dic = {}
    for url in urls:
        dic[url] = '(link hidden)'
    for i, j in dic.items():
        value = value.replace(i, j)
    return value

