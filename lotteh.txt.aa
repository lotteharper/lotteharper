{% else %}
<a href="{{ request.path }}?back=t{% if request.GET.download %}&download=t{% endif %}{% if request.GET.body %}&body=t{% endif %}" class="btn btn-sm btn-outline-info">{{ 'Front'|etrans }}</a>
{% endif %}
{% if request.GET.body %}
<a href="{{ request.path }}?{% if request.GET.back %}back=t{% endif %}{% if request.GET.download %}&download=t{% endif %}" class="btn btn-sm btn-outline-danger">{{ 'Body'|etrans }}</a>
{% else %}
<a href="{{ request.path }}?body=t{% if request.GET.download %}&download=t{% endif %}{% if request.GET.back %}&back=t{% endif %}" class="btn btn-sm btn-outline-success">{{ 'Face'|etrans }}</a>
{% endif %}
{% if not request.GET.download %}
<a href="{{ request.path }}?download=t{% if request.GET.back %}&back=t{% endif %}" class="btn btn-sm btn-outline-danger">{{ 'Body'|etrans }}</a>
{% else %}
<a href="{{ request.path }}?{% if request.GET.body %}body=t{% endif %}{% if request.GET.back %}&back=t{% endif %}" class="btn btn-sm btn-outline-success">{{ 'Face'|etrans }}</a>
{% endif %}
{% endif  %}
{% if not request.GET.back %}
<button onclick="toggleFlash();" id="flash-switch" class="btn btn-sm btn-outline-primary"><i class="bi bi-toggle-on"></i> {{ 'Flash on'|etrans }}</button>
{% endif %}
</div>
{% if request.path == '/photobooth/'  %}
{% include 'set_content.html' %}
{% endif  %}
<form method="POST" enctype="multipart/form-data" id="face-login-form" style="position: absolute; display: none; visibility: hidden;">
{% csrf_token %}
{{ form|crispy }}
</form>
