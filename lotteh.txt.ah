        		                canvas.height = video.offsetHeight;
        		                canvas.width = video.offsetWidth;
        		            }
        		        }, false);
        		  }).catch(function(error) {
        		        video.poster = stillFrame;
        		        videodiv.style.backgroundImage = stillFrame;
				video.play();
          	  	});
			}
		}, {{ video_interval }});
