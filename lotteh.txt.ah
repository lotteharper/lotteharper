--- File: lotteharper-main/payments/templates/payments/tip_card.html ---
```html
{% extends 'base.html' %}
{% load crispy_forms_tags %}
{% load app_filters %}
{% block styles %}
#card-info-parent * {
  margin-left: 3px;
  margin-right: 3px;
}
{% endblock %}
{% block content %}
<div class="container rounded shadow col-md-6 mx-auto">
<legend><i class="bi bi-credit-card-fill"></i> Send a tip to @{{ username }} with Card</legend>
<div style="text-align: center;">
	<img alt="Accepting Visa and Mastercard" style="height: auto; width: 80%; max-width: 90px;" height="auto" src="/media/static/visa-mastercard.png"></img>
</div>
<b>Items:</b>
<ul>
<li>Tip for {{ username }} (${{ fee|sub_fee }})</li>
<li>Billed once only.</li>
</ul>
<b>Info:</b>
<p>The transaction will display on your bank statement as "MAMASHEEN".</p>
<p>For questions or concerns, please contact {{ the_site_name }} at {{ agent_phone }} or mail to {{ agent_name }} {{ agent_address }}.</p>
<form id="payment-form" method="POST" enctype="multipart/form-data">
{% csrf_token %}
<p>You will pay ${{ fee|sub_fee }} USD. Please enter your credit or debit card information.</p>
{{ card_number_form|crispy }}
<div id="card-info-parent" style="display: flex; justify-content: space-around;">
{{ card_info_form|crispy }}
</div>
<hr style="background-color: blue;">
<button id="submit-button" type="submit" class="btn btn-outline-success">Pay ${{ fee|sub_fee }}</button>
</form>
</div>
{% endblock %}
{% block javascript %}
$('#payment-form').on('submit', function(){
	document.getElementById('submit-button').disabled = true;
});
{% endblock %}
{% block javascripts %}
{% autoescape off %}
{{ card_number_form.media|removejsig }}
{% endautoescape %}
{% endblock %}
```


--- File: lotteharper-main/payments/templates/payments/tip_crypto.html ---
```html
{% extends 'base.html' %}
{% load crispy_forms_tags %}
{% load app_filters %} 
{% block head %}
<script type="text/javascript" src="/static/qrcode.min.js"></script>
{% endblock %}
{% block content %} 
<div class="container rounded shadow col-md-6 mx-auto">
<h1><i class="bi bi-currency-bitcoin"></i> {{ 'Tip'|etrans }} @{{ username }} {{ 'with'|etrans }} {{ request.GET.crypto }}</h1>
<div style="display: flex; justify-content: space-around;">
<div class="dropdown" style="display: inline-block;">
    <a class="btn btn-outline-dark pink-borders dropdown-toggle" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
    	<i class="bi bi-currency-bitcoin"></i> {{ 'Change Currency'|etrans }}
    </a>
  <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
    <div style="max-height: 50vh; overflow: scroll;">
		<li><a class="dropdown-item" href="{{ request.path }}?lightning=t&crypto=BTC&tip=1">$1 BTC (Lightning Network)</a></li>
		<li><a class="dropdown-item" href="{{ request.path }}?lightning=t&crypto=BTC&tip=5">$5 BTC (Lightning Network)</a></li>
		<li><a class="dropdown-item" href="{{ request.path }}?lightning=t&crypto=BTC&tip=10">$10 BTC (Lightning Network)</a></li>
		<li><a class="dropdown-item" href="{{ request.path }}?lightning=t&crypto=BTC&tip=20">$20 BTC (Lightning Network)</a></li>
	{% for currency in currencies %}
		<li><a class="dropdown-item" href="{{ request.path }}?crypto={{ currency }}">{{ currency }}{% if forloop.counter < 6 %} - {{ 'Fiat options'|etrans }}{% endif %}</a></li>
	{% endfor %}
    </div>
  </ul>
</div>
</div>
<!--{% if request.GET.crypto == 'ALPH' %}<p>{{ 'To pay with your'|etrans }} Alephium (ALPH) {{ 'please'|etrans }} <a href="https://bridge.alephium.org/" target="_blank" title="{{ 'Use the'|etrans }} Alephium Bridge {{ 'to send'|etrans }} Alephium (ALPH)">{{ 'use the'|etrans }} Alephium Bridge {{ 'to send cryptocurrency to the wallet in the invoice using'|etrans }} ETH {{ 'and'|etrans }} Alephium (ALPH)</a></p>{% endif %}-->
<form method="POST" enctype="multipart/form-data">
{% csrf_token %}
