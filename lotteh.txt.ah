        if(cameraUpdateOpen) {
            cameraSettings.height = '600px';
            $('#hide-dupe').removeClass('hide');
        } else {
            cameraSettings.height = '0px';
            $('#hide-dupe').addClass('hide');
        }
    });
});
function generateRandomString(length = 6) {
