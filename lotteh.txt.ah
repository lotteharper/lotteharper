  }
  if(!live) {
      recordingStartTime = new Date().getTime()/1000;
      live = true;
      mediaRecorder.start();
      console.log(mediaRecorder.state);
      console.log("recorder started");
      document.getElementById("pipOverlayStream").style.border = "4px solid red";
