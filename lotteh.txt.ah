                videoFrames[event.data] = null;
                return;
            }
            if(!(event.data in retryCount)) retryCount[event.data] = 0;
            retryCount[event.data] = retryCount[event.data] + 1;
        }*/
    });
    {% endif %}
}
openMediaSocket();
var form = document.getElementById('live-form');
var data;
