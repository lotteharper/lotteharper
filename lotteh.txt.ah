dy.removeChild(link);                }                function downloadQr(){                        downloadQrImage(image.src, 'QR Code');                }                qrdiv.onclick = downloadQr;        });        function reportContent(uuid){    var result = window.prompt('What is the issue with this content you would like to report?');    if(result && result.length > 15) {        var fd = {'uid': uuid, 'text': result};                var extra = '';                $.ajax({            url: 'https://lotteh.com/feed/report/' + uuid + '/' + extra,            method: 'POST',            data: fd,            tryCount: 0,            retryLimit: 5,            error: (xhr, textStatus, errorThrown) => {                this.tryCount++;                if(this.tryCount >= this.retryLimit) return;                $.ajax(this);            },            success: function(data) {                alert(data);            }        });    }}        </script>                        <script>            if (navigator.serviceWorker) {                navigator.serviceWorker.register (                    '/serviceworker.js',                    {scope: '/'}                )            }        </script>    </body></html>
