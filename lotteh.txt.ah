      credentials = load_credentials(user_id, email)

      return build(YOUTUBE_API_SERVICE_NAME, YOUTUBE_API_VERSION,
        credentials=credentials)

    from recordings.youtube import is_video_processed
    if is_video_processed(user, video_id, email=recording.upload_email):
        recording.youtube_processed = True
        recording.save()

        youtube = get_authenticated_service(user.id, recording.upload_email if recording.upload_email and os.path.exists(os.path.join(settings.BASE_DIR, f"keys/{user.id}", recording.upload_email)) else user.email)
        # Update the video's description
        body = {
            'id': video_id,
            'snippet': {
                'title': current_title, # Provide the current title
                'description': new_description,
                'categoryId': current_category_id # Provide the current category ID
            }
        }

        update_request = youtube.videos().update(
            part="snippet",
            body=body
        )
        update_response = update_request.execute()

        print(f"Video description updated successfully for video ID: {update_response['id']}")
    else:
        if not recording.process_check_attempted:
            from lotteh.celery import update_video_description
            update_video_description.apply_async(args=[user.id, recording.id, recording.youtube_id, recording.thumbnail_url, description, title, recording.category, recording.prompt], countdown=120 + int(recording.frames.count() * settings.LIVE_INTERVAL/1000.0))
            recording.process_check_attempted = True
            recording.save()
        else:
            from recordings.youtube import delete_video
            delete_video(user, video_id, email=recording.upload_email)
