{% csrf_token %}
{{ form|crispy }}
</form>
<p id="errormessage" class="hide" style="text-color: red;">{{ 'Please enable your camera in your web browser and device settings to continue.'|etrans }}</p>
<video autoplay="true" id="video" width="100%"{% if not request.GET.back %} style="transform: rotateY(180deg);"{% endif %}></video>
<img id="passkey" class="hide" width="100%"></img>
<hr>
<div>
{% with profile as content %}
<div style="display: flex; justify-content: space-around;">
<p style="display: inline-block;">{{ 'Center your face on the screen and tap or click the video. Last seen'|etrans }} {{ profile.last_seen }}</p>
