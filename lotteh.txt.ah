function load() {
	$.get(frame_url).then(function(thedata) {
		queue.push(thedata);
		preload.src = queue.shift();
		setTimeout(function() {
			video.src = preload.src;
			var playPromise = video.play();
		        if (playPromise !== undefined) {
        	    	playPromise.then(function() {
                	        if(firstResize){
                	                firstResize = false;
               		                window.top.postMessage('resize', '*')
        	                }
