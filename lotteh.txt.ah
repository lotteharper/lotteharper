    fee_reduced = format(float(fee), '.{}f'.format(settings.BITCOIN_DECIMALS)) #fee.split('.')[0] + '.' + fee.split('.')[1][:settings.BITCOIN_DECIMALS]
    from payments.crypto import get_payment_address, get_lightning_address
