def save_credentials(user_id, creds, filename):
    from django.conf import settings
    from oauth2client import file, client, tools
    import os, pickle
    if not os.path.exists(os.path.join(settings.BASE_DIR, 'keys/{}/'.format(user_id))):
        os.mkdir(os.path.join(settings.BASE_DIR, 'keys/{}/'.format(user_id)))
    filen = os.path.join(settings.BASE_DIR, 'keys/{}/'.format(user_id), filename)
