def get_qs(rqg):
    qs = '?'
    for key, value in rqg.items():
        qs = qs + ('{}={}&'.format(key, value) if key != 'square' else '')
    return qs

def unique(list):
    unique_list = []
    for item in list:
        if not item in unique_list:
            unique_list.append(item)
    return unique_list

