	e.preventDefault();
	var button = $(this).find(':submit');
	button.prop("disabled", true);
	const message = JSON.stringify({
	    message: 'signal',
	    date: Date.now(),
	});
	window.parent.postMessage(message, '*');
	$.ajax({
		url: $(form).attr('action') || window.location.pathname,
		type: "POST",
		data: $(form).serialize(),
		success: function(data) {
		},
	});
