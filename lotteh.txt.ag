var qrdiv = document.getElementById("qrcode");
var qr = new QRCode(qrdiv, "https://lotteh.com");
var image = qrdiv.querySelector('img');
image.style.width = "100%";
image.style.maxWidth = "400px";
const input = document.querySelector('#text-input');
var textValue = "https://lotteh.com";
var textUpdated = false;
input.addEventListener('input', (event) => {
	textValue = event.target.value;
	textUpdated = true;
});
setInterval(function() {
	if(textUpdated) {
		qr.makeCode(textValue);
		textUpdated = false;
	}
}, 1000);
function downloadImage(url, filename) {
  const link = document.createElement('a');
  link.href = url;
  link.download = 'Lotte Harper - ' + filename;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}
function download(){
	downloadImage(image.src, 'QR Code');
}
qrdiv.onclick = download;

