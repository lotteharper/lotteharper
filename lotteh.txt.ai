    cvctx.clearRect(0, 0, cvcanvas.width, cvcanvas.height);
    cvctx.drawImage(localVideo, 0, 0, Math.trunc(localVideo.videoWidth * {{ nudity_censor_scale }}), Math.trunc(localVideo.videoHeight * {{ nudity_censor_scale }}));
