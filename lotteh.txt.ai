    <div id="chat-overlay">
        <div id="chatbox">{% for message in camera.user.stream_messages|recent_stream_messages:1 %}<div><b>{% if message.user %}@{{ message.user.profile.name }}{% if message.user == vendor %} (Streamer){% endif %}{% else %}Guest{% endif %}:</b> {{ message.message }}</div>{% endfor %}</div>
        <div class="input-group mb-3">
            <input id="chatinput" type="text" class="form-control" placeholder="{{ 'Type your message here'|etrans }}" aria-label="{{ 'Message'|etrans }}">
