  margin: auto;
}

#video {
  width: 100%;
  height: auto;
  display: block;
}

#chat-overlay {
  position: absolute;
  bottom: 10px; /* Above controls */
  right: 10px;
  width: 300px;
  max-width: 90%;
  max-height: 60%;
  min-height: 30%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 10px;
  padding: 10px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

#chatbox {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 5px;
}

#chatinput {
  width: 100%;
  padding: 5px;
  border: none;
  border-radius: 5px;
}

#rec-status {
    position: absolute;
    top: 5px;
    left: 50%;
}
#fullscreenToggle {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
}
video {
    width: 100%;
    pointer-events: none;
}
{% if camera.user.vendor_profile.video_intro_font %}
