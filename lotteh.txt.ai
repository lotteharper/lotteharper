{% include 'navbar.html' %}
{% endif %}
{% if request.path != '/' %}
<div style="height: 10px;"></div>
{% endif %}
<main id="main-container" class="container-fluid{% if nopadding %} ml-0 mr-0 px-0 my-0 py-0{% endif %} clemn" style="width: {% if full or request.path|startswith:'/admin/' %}100{% else %}90{% endif %}%;">
