    filename = "%s.%s" % (get_random_string(length=settings.SECURE_MEDIA_CODE_LENGTH) + '-{}'.format(u), ext)
    return os.path.join('media/secure/video/', filename), '{}'.format(filename)

def get_secure_path(filename):
