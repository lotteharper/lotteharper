```python
def download_image_from_url(image_url, save_path):
    import requests
    """
    Downloads an image from a given URL and saves it to a specified local path.

    Args:
        image_url (str): The URL of the image to download.
        save_path (str): The local path where the image will be saved, including the filename and extension.
    """
    try:
        response = requests.get(image_url, stream=True)
        response.raise_for_status()  # Raise an exception for bad status codes (4xx or 5xx)

        with open(save_path, 'wb') as file:
            for chunk in response.iter_content(chunk_size=8192):
                file.write(chunk)
        print(f"Image successfully downloaded to: {save_path}")
    except requests.exceptions.RequestException as e:
        print(f"Error downloading image: {e}")

def upload_recording(recording, camera):
    from django.conf import settings
    from live.duration import get_duration
    video_duration = get_duration(recording.file.path)
    if video_duration > (7.5 if (settings.LIVE_INTERVAL/1000 * 1.5) <= 7.5 else (settings.LIVE_INTERVAL/1000 * 1.5)):
        from better_profanity import profanity
        import traceback
        import pytz
        transcript = '\nTranscript: ' if (recording.transcript and len(recording.transcript) > 0) else ''
        description = profanity.censor(camera.description) + transcript + profanity.censor(recording.transcript[:4000]) + '\nRecorded on ' + recording.last_frame.astimezone(pytz.timezone(settings.TIME_ZONE)).strftime('%A %B %d, %Y at %H:%M:%S')
        title = profanity.censor(camera.title[:70])
        print(description)
        import os
        try:
            if not recording.youtube_id:
                from recordings.youtube import upload_youtube
                id, recording = upload_youtube(
                    camera.user,
                    recording,
                    recording.file.path,
                    title,
                    description,
                    [profanity.censor(tag) for tag in camera.tags.split(',')],
                    category=camera.category,
                    privacy_status=camera.privacy_status if recording.public else 'private',
                    age_restricted=not recording.public)
                from lotteh.celery import update_video_description
                update_video_description.apply_async(args=[camera.user.id, recording.id, id, recording.thumbnail_url, description, title, camera.category, camera.prompt if camera.prompt else recording.prompt if recording.prompt else None], countdown=120 + int(recording.frames.count() * settings.LIVE_INTERVAL/1000.0))
                recording.title = title
                recording.description = description
                recording.category = camera.category
                recording.duration = video_duration
                recording.podcast = camera.podcast
                if recording.public and (recording.upload_playlist != '' or camera.upload_playlist != ''):
                    from recordings.youtube import add_to_playlist
                    add_to_playlist(camera.user, camera.upload_playlist if not recording.upload_playlist else recording.upload_playlist, id, email=recording.upload_email if recording.upload_email else camera.upload_email)
            if camera.podcast and camera.podcast_show_id and recording.public:
                from live.audio import get_temp_mp3
                mp3_path = get_temp_mp3(recording.file.path)
                from live.podcast import upload_podcast
                from recordings.youtube import get_youtube_url
                from dateutil.relativedelta import relativedelta
                from live.models import VideoRecording
                from django.utils import timezone
                episode_number = VideoRecording.objects.filter(public=True, uploaded=True, podcast=True, last_frame__gte=timezone.now()-relativedelta(months=12)).count() + 1 # episode_number = None
                season_number = (timezone.now().year - VideoRecording.objects.order_by('last_frame').first().last_frame.year) + 1
                upload_podcast(camera.user, camera.podcast_show_id, mp3_path, episode_number, season_number, title, description, recording.transcript, image_url=recording.thumbnail_url, explicit=not recording.public, video_url=get_youtube_url(id), keywords=camera.tags)
                os.remove(mp3_path)
            recording.uploaded = True
        except:
            recording.uploaded = False
            print(traceback.format_exc())
        recording.save()
        return recording

from google.oauth2.credentials import Credentials
from googleapiclient.discovery import build
from google_auth_oauthlib.flow import InstalledAppFlow
from google.auth.transport.requests import Request
from recordings.youtube import load_credentials, save_credentials

def update_description(user, recording, video_id, new_description, current_title, current_category_id):
    from django.urls import reverse
    from django.conf import settings

    import httplib2
    import os
    import random
    import sys
    import time
    import traceback

    from apiclient.discovery import build
    from apiclient.errors import HttpError
    from apiclient.http import MediaFileUpload
    from oauth2client.client import flow_from_clientsecrets
    from oauth2client.file import Storage
    from oauth2client.tools import argparser, run_flow


    # Explicitly tell the underlying HTTP transport library not to retry, since
    # we are handling retry logic ourselves.
    httplib2.RETRIES = 1

    # Maximum number of times to retry before giving up.
    MAX_RETRIES = 10

    # Always retry when these exceptions are raised.
    RETRIABLE_EXCEPTIONS = (httplib2.HttpLib2Error, IOError)

    # Always retry when an apiclient.errors.HttpError with one of these status
    # codes is raised.
    RETRIABLE_STATUS_CODES = [500, 502, 503, 504]

    # The CLIENT_SECRETS_FILE variable specifies the name of a file that contains
    # the OAuth 2.0 information for this application, including its client_id and
    # client_secret. You can acquire an OAuth 2.0 client ID and client secret from
    # the Google API Console at
    # https://console.cloud.google.com/.
    # Please ensure that you have enabled the YouTube Data API for your project.
    # For more information about using OAuth2 to access the YouTube Data API, see:
    #   https://developers.google.com/youtube/v3/guides/authentication
    # For more information about the client_secrets.json file format, see:
    #   https://developers.google.com/api-client-library/python/guide/aaa_client_secrets
    CLIENT_SECRETS_FILE = "client_secrets.json"

    # This OAuth 2.0 access scope allows an application to upload files to the
