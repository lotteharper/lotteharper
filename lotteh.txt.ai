--- File: lotteharper-main/recordings/urls.py ---
```python
from django.urls import path
from . import views

app_name='recordings'

urlpatterns = [
    path('profile/<str:username>/', views.recordings, name='recordings'),
    path('profile/<str:username>/idle/', views.recording_idle, name='recording_idle'),
    path('<str:uuid>/', views.recording, name='recording'),
    path('<str:uuid>/<int:index>/', views.recording_frame, name='recording-frame'),
    path('<int:pk>/delete/', views.RecordingDeleteView.as_view(template_name='recordings/recording_confirm_delete.html'), name='recording-delete'),
    path('', views.recent, name='recent'),
]
```


--- File: lotteharper-main/recordings/views.py ---
```python
from django.contrib.auth.decorators import login_required
from django.contrib.auth.decorators import user_passes_test
from vendors.tests import is_vendor
from feed.tests import pediatric_identity_verified, minor_identity_verified
from barcode.tests import minor_document_scanned
from django.views.decorators.csrf import csrf_exempt

@login_required
@user_passes_test(is_vendor)
@user_passes_test(minor_identity_verified, login_url='/verify/', redirect_field_name='next')
def recent(request):
    from live.models import VideoRecording
    from django.utils import timezone
    import datetime
    from_date = timezone.now() - datetime.timedelta(hours=24)
    uploaded = VideoRecording.objects.filter(user=request.user, processed=True, uploaded=True, last_frame__gte=from_date).exclude(youtube_id='').order_by('-last_frame')
    proc = VideoRecording.objects.filter(user=request.user, processing=True, processed=False, last_frame__gte=from_date).order_by('-last_frame')
    nonproc = VideoRecording.objects.filter(user=request.user, processed=False, processing=False, last_frame__gte=from_date).order_by('-last_frame')
    from django.shortcuts import render
    return render(request, 'recordings/status.html', {
        'title': 'Review your recordings',
        'uploaded_vids': uploaded,
        'processing_vids': proc,
        'nonprocessing_vids': nonproc,
    })

