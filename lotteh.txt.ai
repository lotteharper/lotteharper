                if(event.target.parentElement.parentElement) {
        			$(event.target.parentElement.parentElement).toggleClass('fade-hidden-fast');
        			setTimeout(function() {
        				$(event.target.parentElement.parentElement).toggleClass('hide');
        			}, 1000);
                }
            }
		}, 5000);
	});
}*/
