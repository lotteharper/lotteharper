async function stopRecordingFn() {
    if(live) {
        live = false;
        if(live && mediaSocket && mediaSocket.readyState === WebSocket.OPEN) {
            document.getElementById("rec-status").innerHTML = '<i style="font-size: 20px;" class="bi bi-circle-fill color-red"></i>';
        } else {
