        page = 1
    return render(request, 'voice/interactives.html', {
        'title': 'Voice Recording Interactive Files',
        'recordings': p.page(page),
        'count': p.count,
        'page_obj': p.get_page(page),
        'current_page': page,
    })

@login_required
@user_passes_test(pediatric_identity_verified, login_url='/verify/', redirect_field_name='next')
