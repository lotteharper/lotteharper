```html
{% extends 'base.html' %}
{% load app_filters %}
{% block content %}
<legend>{{ 'Surveys'|etrans }} <a href="{% url 'survey:update' 'new' %}" class="btn btn-sm btn-outline-info" style="float: right;">New</a></legend>
{% for survey in surveys %}
<p style="white-space: pre-wrap;">
<b>{{ survey.question|trans }}</b>
<ul>
{% for answer in survey.answers_seperated|splitlines %}
<li>{{ answer|trans }}</li>{% if survey.answers_seperated|splitlines|length != forloop.counter %} ‚ö¨ {% endif %}
{% endfor %}
</ul>
</p>
<a href="{% url 'survey:update' survey.id %}" class="btn btn-sm btn-outline-info" style="float: right;">{{ 'Update'|etrans }}</a>
<hr style="color: blue;">
{% endfor %}
<hr style="color: blue;">
{% endblock %}
