--- File: lotteharper-main/vibe/templates/vibe/remote_vibe.html ---
```html
{% extends 'base.html' %}
{% block style %}
html {
    -ms-touch-action: none;
    touch-action: none;
}
body {
    overflow: hidden;
    margin-top: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
    margin-left: 0px;
}
#main {
    overflow: hidden;
    margin-top: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
    margin-left: 0px;
}
#main-container {
    overflow: hidden;
    margin-top: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
    margin-left: 0px;
}
html, body, main {
    margin: 0 !important;
    padding: 0 !important;
}
button, b {
    font-size: 60px;
}
{% endblock %}
{% block head %}
    <script src="https://code.createjs.com/1.0.0/createjs.min.js"></script>
{% endblock %}
{% block content %}
<div style="height: 60px;"></div>
<button id="reset" class="btn btn-outline-dark">Reset</button>
<canvas id="interactive-canvas" style="width: 100vw; height: 85vh;"></canvas>
{% endblock %}
{% block javascript %}
var theCanvas = document.getElementById('interactive-canvas');      
var socket;
  var WRITE_INTERVAL = 250;
  var CIRCLE_RADIUS = window.innerWidth * 0.50;
  var OFF_RADIUS = CIRCLE_RADIUS * 0.3;
  var ON_THRESHOLD = 60;
  var DEAD_ZONE = 3;
  var OFFSET_MIN = 25;
  var OFFSET_MOD = 1;
  var interval = null;
  var circle = null;
  var x = 128;
  var y = 128;
  var device;
  var heightFactor = 0.80;
  var mouseToggle = false;
const scale = (fromRange, toRange) => {
    	const d = (toRange[1] - toRange[0]) / (fromRange[1] - fromRange[0]);
        return from =>  (from - fromRange[0]) * d + toRange[0];
};
  function init() {
    var offset = 200;
    var direction = true;
    var currVal = 0;
    var valMod = 0.3;
    var vals = [];
    function writeValues() {
      var data = null;
  if(Math.abs(128 - y) < DEAD_ZONE && Math.abs(128 - x) < DEAD_ZONE){
    // Stop it
        data = new Uint8Array([128, 128, 128, 128, offset]);
  } else {
        // Make it smooth - Map values larger
    var tox = x;
    if(tox > 128){ // 0-75
            tox = tox + valMod * vals[currVal%vals.length];
            tox = scale([128 + 15, 255], [128 + ON_THRESHOLD, 255])(tox);
    } else if(tox < 128) {
            tox = tox - valMod * vals[currVal%vals.length];
            tox = scale([128 - 15, 0], [128 - ON_THRESHOLD, 0])(tox);
    }
    var toy = y;
    if(toy > 128){ // 0-75
            toy = toy + valMod * vals[currVal%vals.length];
            toy = scale([128 + 15, 255], [128 + ON_THRESHOLD, 255])(toy);
        } else if(toy < 128) {
            toy = toy - valMod * vals[currVal%vals.length];
            toy = scale([128 - 15, 0], [128 - ON_THRESHOLD, 0])(toy);
        }
        data = new Uint8Array([255-parseInt(toy), parseInt(toy), 255-parseInt(tox), parseInt(tox), offset]);
	  }
  	  socket.send(new String(255-parseInt(tox)) + ',' + new String(255-parseInt(toy)));
        currVal++;
    }
function openSocket() {
	socket = new WebSocket("wss://" + window.location.hostname + '/ws/vibe/remote/send/');
	socket.addEventListener("open", (event) => {
		console.log("Socket open.");
		setInterval(writeValues, WRITE_INTERVAL);
	});
	socket.addEventListener("close", (event) => {
		console.log("Socket closed.");
		setTimeout(function() { openSocket(); }, {{ reload_time }});
	});
}
