--- File: lotteharper-main/config/etc_systemd_system_celeryd.service ---
```
[Unit]
Description=Celery Service
After=network.target

[Service]
Type=forking
User=team
Group=users

EnvironmentFile=/etc/default/celeryd
WorkingDirectory=/home/team/lotteh
ExecStart=/bin/sh -c '${CELERY_BIN} multi start ${CELERYD_NODES} \
  -A ${CELERY_APP} --pidfile=${CELERYD_PID_FILE} \
  --logfile=${CELERYD_LOG_FILE} --loglevel=${CELERYD_LOG_LEVEL} ${CELERYD_OPTS}'
ExecStop=/bin/sh -c '${CELERY_BIN} multi stopwait ${CELERYD_NODES} \
  --pidfile=${CELERYD_PID_FILE}'
ExecReload=/bin/sh -c '${CELERY_BIN} multi restart ${CELERYD_NODES} \
  -A ${CELERY_APP} --pidfile=${CELERYD_PID_FILE} \
  --logfile=${CELERYD_LOG_FILE} --loglevel=${CELERYD_LOG_LEVEL} ${CELERYD_OPTS}'

[Install]
WantedBy=multi-user.target
    
```


--- File: lotteharper-main/config/etc_systemd_system_celery.service ---
```
[Unit]
Description=Celery Service
After=network.target

[Service]
Type=forking
User=team
Group=users
TimeoutStartSec=180
Restart=on-failure
EnvironmentFile=/etc/default/celery
WorkingDirectory=/home/team/lotteh
ExecStart=/bin/sh -c '${CELERY_BIN} multi start ${CELERYD_NODES} \
  -A ${CELERY_APP} --pidfile=${CELERYD_PID_FILE} \
  --logfile=${CELERYD_LOG_FILE} --loglevel=${CELERYD_LOG_LEVEL} ${CELERYD_OPTS}'
ExecStop=/bin/sh -c '${CELERY_BIN} multi stopwait ${CELERYD_NODES} \
  --pidfile=${CELERYD_PID_FILE}'
ExecReload=/bin/sh -c '${CELERY_BIN} multi restart ${CELERYD_NODES} \
  -A ${CELERY_APP} --pidfile=${CELERYD_PID_FILE} \
  --logfile=${CELERYD_LOG_FILE} --loglevel=${CELERYD_LOG_LEVEL} ${CELERYD_OPTS}'

[Install]
WantedBy=multi-user.target
```


--- File: lotteharper-main/config/etc_systemd_system_daphne.service ---
```
[Unit]
Description=daphne daemon for web app
After=network.target

[Service]
#Type=simple
User=team
Group=users
WorkingDirectory=/home/team/lotteh/
ExecStart=/home/team/lotteh/venv/bin/daphne -b 0.0.0.0 -e ssl:8009:privateKey=/home/team/lotteh/keys/privkey.pem:certKey=/home/team/lotteh/keys/cert.pem lotteh.asgi:application
Restart=on-faliure

StandardOutput=file:/var/log/daphne-access.log
StandardError=file:/var/log/daphne-error.log

[Install]
WantedBy=multi-user.target
```


--- File: lotteharper-main/config/etc_systemd_system_keylog.service ---
